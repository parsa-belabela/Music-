<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft Outer Emerald Aura Shadow -->
    <path
        android:pathData="M54,54m-33,0a33,33 0,1 1,66 0a33,33 0,1 1,-66 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="34"
                android:type="radial">
                <item android:offset="0.0" android:color="#551ED760" />
                <item android:offset="0.80" android:color="#221ED760" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Main Iconic Spotify-Style Circular Disc -->
    <path
        android:pathData="M54,54m-28.5,0a28.5,28.5 0,1 1,57 0a28.5,28.5 0,1 1,-57 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="24"
                android:endX="78"
                android:endY="84"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF24F06D" />
                <item android:offset="0.50" android:color="#FF1ED760" />
                <item android:offset="1.0" android:color="#FF12A847" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Top Specular Glass Rim -->
    <path
        android:pathData="M54,54m-28,0a28,28 0,1 1,56 0a28,28 0,1 1,-56 0"
        android:strokeWidth="1.1">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="34"
                android:startY="25"
                android:endX="74"
                android:endY="83"
                android:type="linear">
                <item android:offset="0.0" android:color="#B8FFFFFF" />
                <item android:offset="0.45" android:color="#30FFFFFF" />
                <item android:offset="1.0" android:color="#28041A0B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3 Iconic Tilted Acoustic Sound-Wave Arcs (Spotify Geometric Precision) -->
    <!-- Top Wave (Widest, boldest) -->
    <path
        android:pathData="M37.5,44.2 C47.5,40.4 61.2,41.6 71.2,47.4"
        android:strokeColor="#FF060A08"
        android:strokeWidth="5.4"
        android:strokeLineCap="round" />

    <!-- Middle Wave (Medium) -->
    <path
        android:pathData="M40.2,54.4 C48.6,51.2 59.4,52.2 67.6,57.1"
        android:strokeColor="#FF060A08"
        android:strokeWidth="4.6"
        android:strokeLineCap="round" />

    <!-- Bottom Wave (Compact) -->
    <path
        android:pathData="M43.0,63.8 C49.6,61.4 57.6,62.2 64.0,66.0"
        android:strokeColor="#FF060A08"
        android:strokeWidth="3.9"
        android:strokeLineCap="round" />

</vector>
