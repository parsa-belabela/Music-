@Composable
fun SearchScreen(
    localTracks: List<Track>,
    onlineTracks: List<Track> = emptyList(),
    currentPlayingTrack: Track? = null,
    isLoadingOnline: Boolean = false,
    isPersian: Boolean = false, // پیش‌فرض انگلیسی؛ زمانی که زبان برنامه فارسی شود اتوماتیک فارسی می‌شود
