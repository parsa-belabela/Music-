@Composable
fun SearchScreen(
    localTracks: List<Track>,
    onlineTracks: List<Track> = CloudflareArchiveCache.cachedTracks,
    onPlayTrack: (Track, List<Track>) -> Unit
) {
    var query by remember { mutableStateOf("") }
    var selectedArtistFilter by remember { mutableStateOf<String?>(null) }

    LaunchedEffect(Unit) {
        CloudflareArchiveCache.ensureLoaded()
    }

    val allCombinedTracks = remember(localTracks, onlineTracks) {
        (localTracks + onlineTracks).distinctBy { "${it.title}_${it.artist}" }
    }

    val matchedArtists = remember(allCombinedTracks, query) {
        val grouped = allCombinedTracks.groupBy { it.artist.trim().ifBlank { "خواننده ناشناس" } }
        if (query.isBlank()) {
            grouped.entries.sortedByDescending { it.value.size }.take(20)
        } else {
            grouped.entries.filter { it.key.contains(query.trim(), ignoreCase = true) }
        }
    }

    val matchedLocalTracks = remember(localTracks, query, selectedArtistFilter) {
        localTracks.filter { track ->
            val matchesArtist = selectedArtistFilter == null || track.artist.equals(selectedArtistFilter, ignoreCase = true)
            val matchesQuery = query.isBlank() ||
                track.title.contains(query, ignoreCase = true) ||
                track.artist.contains(query, ignoreCase = true)
            matchesArtist && matchesQuery
        }.take(40)
    }

    val matchedCloudTracks = remember(onlineTracks, query, selectedArtistFilter) {
        onlineTracks.filter { track ->
            val matchesArtist = selectedArtistFilter == null || track.artist.equals(selectedArtistFilter, ignoreCase = true)
            val matchesQuery = query.isBlank() ||
                track.title.contains(query, ignoreCase = true) ||
                track.artist.contains(query, ignoreCase = true) ||
                track.album.contains(query, ignoreCase = true)
            matchesArtist && matchesQuery
        }.take(50)
    }

    LazyColumn(
        modifier = Modifier
            .fillMaxSize()
            .background(Color(0xFF090B10)),
        contentPadding = PaddingValues(bottom = 120.dp)
    ) {
        item {
            Column(modifier = Modifier.padding(16.dp)) {
                Text(
                    text = "جستجوی هوشمند (گوشی + آرشیو تلگرام)",
                    color = Color.White,
                    fontSize = 22.sp,
                    fontWeight = FontWeight.ExtraBold
                )
                Spacer(modifier = Modifier.height(12.dp))
                OutlinedTextField(
                    value = query,
                    onValueChange = {
                        query = it
                        selectedArtistFilter = null
                    },
                    placeholder = {
                        Text(
                            text = "جستجوی آهنگ، خواننده یا آلبوم در گوشی و کلادفلر...",
                            color = Color.White.copy(alpha = 0.5f),
                            fontSize = 13.sp
                        )
                    },
                    leadingIcon = {
                        Icon(Icons.Default.Search, contentDescription = null, tint = Color(0xFF1DB954))
                    },
                    trailingIcon = {
                        if (query.isNotEmpty() || selectedArtistFilter != null) {
                            IconButton(onClick = {
                                query = ""
                                selectedArtistFilter = null
                            }) {
                                Icon(Icons.Default.Clear, contentDescription = null, tint = Color.White)
                            }
                        }
                    },
                    singleLine = true,
                    shape = RoundedCornerShape(16.dp),
                    colors = OutlinedTextFieldDefaults.colors(
                        focusedContainerColor = Color.White.copy(alpha = 0.08f),
                        unfocusedContainerColor = Color.White.copy(alpha = 0.05f),
                        focusedBorderColor = Color(0xFF1DB954),
                        unfocusedBorderColor = Color.White.copy(alpha = 0.1f),
                        focusedTextColor = Color.White,
                        unfocusedTextColor = Color.White
                    ),
                    modifier = Modifier.fillMaxWidth()
                )
            }
        }

        // پروفایل خواننده‌ها (با عکس واقعی از API یا تایپوگرافی مدرن اسم خواننده - بدون کاور آهنگ)
        if (matchedArtists.isNotEmpty()) {
            item {
                Text(
                    text = if (query.isBlank()) "هنرمندان پیشنهادی" else "پروفایل خوانندگان",
                    color = Color.White,
                    fontSize = 17.sp,
                    fontWeight = FontWeight.Bold,
                    modifier = Modifier.padding(horizontal = 16.dp, vertical = 8.dp)
                )
                LazyRow(
                    contentPadding = PaddingValues(horizontal = 16.dp),
                    horizontalArrangement = Arrangement.spacedBy(14.dp)
                ) {
                    items(matchedArtists, key = { it.key }) { (artistName, tracks) ->
                        val isSelected = selectedArtistFilter == artistName
                        Column(
                            modifier = Modifier
                                .width(96.dp)
                                .clip(RoundedCornerShape(14.dp))
                                .background(
                                    if (isSelected) Color(0xFF1DB954).copy(alpha = 0.2f)
                                    else Color.Transparent
                                )
                                .clickable {
                                    selectedArtistFilter = if (isSelected) null else artistName
                                }
                                .padding(6.dp),
                            horizontalAlignment = Alignment.CenterHorizontally
                        ) {
                            SpotifyArtistAvatar(
                                artistName = artistName,
                                size = 80.dp,
                                shape = CircleShape
                            )
                            Spacer(modifier = Modifier.height(6.dp))
                            Text(
                                text = artistName,
                                color = if (isSelected) Color(0xFF1DB954) else Color.White,
                                fontSize = 12.sp,
                                fontWeight = FontWeight.Bold,
                                maxLines = 1,
                                overflow = TextOverflow.Ellipsis,
                                textAlign = TextAlign.Center
                            )
                            Text(
                                text = "${tracks.size} ترک",
                                color = Color.White.copy(alpha = 0.5f),
                                fontSize = 10.sp
                            )
                        }
                    }
                }
                Spacer(modifier = Modifier.height(16.dp))
            }
        }

        // نتایج آرشیو ابری تلگرام / کلادفلر
        if (matchedCloudTracks.isNotEmpty()) {
            item {
                Row(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(horizontal = 16.dp, vertical = 8.dp),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Icon(
                        imageVector = Icons.Default.CloudDone,
                        contentDescription = null,
                        tint = Color(0xFF1DB954),
                        modifier = Modifier.size(20.dp)
                    )
                    Spacer(modifier = Modifier.width(8.dp))
                    Text(
                        text = if (query.isBlank() && selectedArtistFilter == null)
                            "پیشنهاد از آرشیو تلگرام (Cloudflare)"
                        else
                            "یافت‌شده در آرشیو تلگرام (${matchedCloudTracks.size})",
                        color = Color.White,
                        fontSize = 17.sp,
                        fontWeight = FontWeight.ExtraBold
                    )
                }
            }

            items(matchedCloudTracks, key = { "search_cf_${it.id}" }) { track ->
                SearchTrackItemRow(
                    track = track,
                    badgeText = "آرشیو ابری",
                    onClick = { onPlayTrack(track, matchedCloudTracks) }
                )
            }
        }

        // نتایج داخل حافظه گوشی
        if (matchedLocalTracks.isNotEmpty()) {
            item {
                Text(
                    text = "آهنگ‌های داخل دستگاه (${matchedLocalTracks.size})",
                    color = Color.White,
                    fontSize = 17.sp,
                    fontWeight = FontWeight.ExtraBold,
                    modifier = Modifier.padding(horizontal = 16.dp, vertical = 10.dp)
                )
            }

            items(matchedLocalTracks, key = { "search_loc_${it.id}" }) { track ->
                SearchTrackItemRow(
                    track = track,
                    badgeText = "حافظه گوشی",
                    onClick = { onPlayTrack(track, matchedLocalTracks) }
                )
            }
        }
    }
}

