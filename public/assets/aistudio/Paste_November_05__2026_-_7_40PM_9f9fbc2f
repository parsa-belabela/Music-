/**
 * مخزن مرکزی کش‌شده برای آهنگ‌های کلادفلر / آرشیو تلگرام
 * تا در HomeScreen و SearchScreen هم بدون بارگذاری مجدد برای پیشنهاد و سرچ در دسترس باشد
 */
object CloudflareArchiveCache {
    var cachedTracks by mutableStateOf<List<Track>>(emptyList())
    var isLoaded by mutableStateOf(false)
    var isLoading by mutableStateOf(false)
    var lastError by mutableStateOf<String?>(null)

    // توجه برای Google AI Studio: آدرس ورکر کلادفلر موجود در پروژه را در این ثابت حفظ کن
    var WORKER_URL: String = "https://your-cloudflare-worker.workers.dev/tracks"

    suspend fun ensureLoaded(forceRefresh: Boolean = false) {
        if (isLoaded && !forceRefresh && cachedTracks.isNotEmpty()) return
        if (isLoading) return
        isLoading = true
        lastError = null
        try {
            val fetched = fetchTracksFromCloudflare(WORKER_URL)
            if (fetched.isNotEmpty()) {
                cachedTracks = fetched
                isLoaded = true
            }
        } catch (e: Exception) {
            lastError = e.localizedMessage ?: "خطا در اتصال به سرور کلادفلر"
        } finally {
            isLoading = false
        }
    }

    private suspend fun fetchTracksFromCloudflare(endpoint: String): List<Track> =
        withContext(Dispatchers.IO) {
            val connection = (URL(endpoint).openConnection() as HttpURLConnection).apply {
                connectTimeout = 8000
                readTimeout = 8000
                requestMethod = "GET"
            }
            if (connection.responseCode != 200) return@withContext emptyList()
            val body = connection.inputStream.bufferedReader().use { it.readText() }
            parseCloudflareJson(body)
        }

    fun parseCloudflareJson(rawJson: String): List<Track> {
        val result = mutableListOf<Track>()
        val array = if (rawJson.trim().startsWith("[")) {
            JSONArray(rawJson)
        } else {
            val obj = JSONObject(rawJson)
            obj.optJSONArray("tracks")
                ?: obj.optJSONArray("data")
                ?: obj.optJSONArray("results")
                ?: JSONArray()
        }

        for (i in 0 until array.length()) {
            val item = array.optJSONObject(i) ?: continue
            val id = item.optString("id").ifBlank { "cf_track_$i" }
            val title = item.optString("title")
                .ifBlank { item.optString("name") }
                .ifBlank { "بدون عنوان" }
            val artist = item.optString("artist")
                .ifBlank { item.optString("performer") }
                .ifBlank { "خواننده ناشناس" }
            val album = item.optString("album")
                .ifBlank { "تک‌آهنگ‌ها ($artist)" }
            val streamUrl = item.optString("url")
                .ifBlank { item.optString("streamUrl") }
                .ifBlank { item.optString("audioUrl") }
                .ifBlank { item.optString("file_url") }
            val coverUrl = item.optString("cover")
                .ifBlank { item.optString("artwork") }
                .ifBlank { item.optString("thumb") }
                .takeIf { it.isNotBlank() }
            val durationMs = item.optLong("duration", 0L).let {
                if (it in 1..10000) it * 1000L else it
            }

            if (streamUrl.isNotBlank()) {
                // سازگار با مدل Track پروژه
                result.add(
                    Track(
                        id = id,
                        title = title,
                        artist = artist,
                        album = album,
                        uri = streamUrl,
                        artworkUri = coverUrl,
                        duration = durationMs
                    )
                )
            }
        }
        return result
    }
}

@Composable
fun OnlineMusicScreen(
    onlineTracks: List<Track> = CloudflareArchiveCache.cachedTracks,
    isLoading: Boolean = CloudflareArchiveCache.isLoading,
    currentPlayingTrack: Track? = null,
    isPersian: Boolean = true,
    onPlayTrack: (Track, List<Track>) -> Unit,
    onRefresh: () -> Unit = {}
) {
    var searchQuery by remember { mutableStateOf("") }
    var selectedCategory by remember { mutableStateOf(OnlineFilterCategory.ALL) }
    var currentSubScreen by remember { mutableStateOf<OnlineSubScreen>(OnlineSubScreen.Explore) }

    // صفحه‌بندی هوشمند برای زمانی که ۵۰۰۰+ آهنگ در آرشیو تلگرام/کلادفلر وجود دارد
    var visibleTrackCount by remember(searchQuery, selectedCategory) { mutableIntStateOf(40) }
    val listState = rememberLazyListState()

    // هندل کردن دکمه بازگشت وقتی کاربر داخل صفحه آلبوم یا پروفایل آرتیست است
    BackHandler(enabled = currentSubScreen != OnlineSubScreen.Explore) {
        currentSubScreen = OnlineSubScreen.Explore
    }

    // استخراج هوشمند آلبوم‌ها و آرتیست‌ها بدون رندر کردن سنگین در هر فریم
    val albumsList = remember(onlineTracks) {
        onlineTracks
            .groupBy { "${it.artist.trim()}__${it.album.trim()}" }
            .map { (_, tracks) ->
                val first = tracks.first()
                CloudAlbumGroup(
                    title = first.album.ifBlank { "تک‌آهنگ‌ها" },
                    artist = first.artist.ifBlank { "خواننده ناشناس" },
                    coverUri = tracks.firstOrNull { !it.artworkUri.isNullOrBlank() }?.artworkUri,
                    tracks = tracks
                )
            }
            .sortedByDescending { it.tracks.size }
    }

    val artistsList = remember(onlineTracks, albumsList) {
        onlineTracks
            .groupBy { it.artist.trim().ifBlank { "خواننده ناشناس" } }
            .map { (artistName, tracks) ->
                CloudArtistGroup(
                    name = artistName,
                    tracks = tracks,
                    albums = albumsList.filter { it.artist.equals(artistName, ignoreCase = true) }
                )
            }
            .sortedByDescending { it.tracks.size }
    }

    // پیشنهادهای هوشمند از آرشیو تلگرام / کلادفلر (بدون مرتب‌سازی الفبایی خشک)
    val suggestedTracks = remember(onlineTracks) {
        onlineTracks.shuffled().take(15)
    }

    val filteredTracks = remember(onlineTracks, searchQuery, selectedCategory, suggestedTracks) {
        val base = when (selectedCategory) {
            OnlineFilterCategory.SUGGESTED -> suggestedTracks
            OnlineFilterCategory.NEWEST -> onlineTracks.reversed()
            else -> onlineTracks
        }
        if (searchQuery.isBlank()) {
            base
        } else {
            val q = searchQuery.trim()
            onlineTracks.filter {
                it.title.contains(q, ignoreCase = true) ||
                    it.artist.contains(q, ignoreCase = true) ||
                    it.album.contains(q, ignoreCase = true)
            }
        }
    }

    val filteredArtists = remember(artistsList, searchQuery) {
        if (searchQuery.isBlank()) artistsList
        else artistsList.filter { it.name.contains(searchQuery.trim(), ignoreCase = true) }
    }

    val filteredAlbums = remember(albumsList, searchQuery) {
        if (searchQuery.isBlank()) albumsList
        else albumsList.filter {
            it.title.contains(searchQuery.trim(), ignoreCase = true) ||
                it.artist.contains(searchQuery.trim(), ignoreCase = true)
        }
    }

    // بارگذاری خودکار صفحه بعدی هنگام اسکرول به انتهای لیست (برای ۵۰۰۰+ آهنگ)
    val shouldLoadMore by remember {
        derivedStateOf {
            val lastVisible = listState.layoutInfo.visibleItemsInfo.lastOrNull()?.index ?: 0
            val totalItems = listState.layoutInfo.totalItemsCount
            totalItems > 0 && lastVisible >= totalItems - 4
        }
    }

    LaunchedEffect(shouldLoadMore) {
        if (shouldLoadMore && visibleTrackCount < filteredTracks.size) {
            visibleTrackCount = (visibleTrackCount + 40).coerceAtMost(filteredTracks.size)
        }
    }

    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(Color(0xFF090B10))
    ) {
        AnimatedContent(
            targetState = currentSubScreen,
            label = "OnlineSubScreenTransition"
        ) { subScreen ->
            when (subScreen) {
                is OnlineSubScreen.ArtistDetail -> {
                    SpotifyArtistDetailView(
                        artist = subScreen.artist,
                        currentPlayingTrack = currentPlayingTrack,
                        onBack = { currentSubScreen = OnlineSubScreen.Explore },
                        onAlbumClick = { currentSubScreen = OnlineSubScreen.AlbumDetail(it) },
                        onPlayTrack = onPlayTrack
                    )
                }

                is OnlineSubScreen.AlbumDetail -> {
                    SpotifyAlbumDetailView(
                        album = subScreen.album,
                        currentPlayingTrack = currentPlayingTrack,
                        onBack = { currentSubScreen = OnlineSubScreen.Explore },
                        onPlayTrack = onPlayTrack
                    )
                }

                is OnlineSubScreen.AllArtistsGrid -> {
                    AllArtistsDirectoryView(
                        artists = filteredArtists,
                        onBack = { currentSubScreen = OnlineSubScreen.Explore },
                        onArtistClick = { currentSubScreen = OnlineSubScreen.ArtistDetail(it) }
                    )
                }

                OnlineSubScreen.Explore -> {
                    LazyColumn(
                        state = listState,
                        modifier = Modifier.fillMaxSize(),
                        contentPadding = PaddingValues(bottom = 120.dp)
                    ) {
                        // ۱. هدر مدرن کلادفلر + آرشیو تلگرام و باکس جستجوی آنی
                        item {
                            CloudflareSpotifyHeader(
                                totalTracksCount = onlineTracks.size,
                                totalArtistsCount = artistsList.size,
                                searchQuery = searchQuery,
                                onSearchChange = { searchQuery = it },
                                onRefresh = onRefresh
                            )
                        }

                        // ۲. تب‌های دسته‌بندی به سبک Spotify
                        item {
                            LazyRow(
                                contentPadding = PaddingValues(horizontal = 16.dp, vertical = 8.dp),
                                horizontalArrangement = Arrangement.spacedBy(8.dp)
                            ) {
                                items(OnlineFilterCategory.entries) { category ->
                                    val selected = selectedCategory == category
                                    FilterChip(
                                        selected = selected,
                                        onClick = { selectedCategory = category },
                                        label = {
                                            Text(
                                                text = if (isPersian) category.labelFa else category.labelEn,
                                                fontWeight = if (selected) FontWeight.Bold else FontWeight.Medium
                                            )
                                        },
                                        colors = FilterChipDefaults.filterChipColors(
                                            selectedContainerColor = Color(0xFF1DB954),
                                            selectedLabelColor = Color.Black,
                                            containerColor = Color.White.copy(alpha = 0.07f),
                                            labelColor = Color.White
                                        ),
                                        border = null,
                                        shape = RoundedCornerShape(50)
                                    )
                                }
                            }
                        }

                        if (isLoading && onlineTracks.isEmpty()) {
                            item {
                                Box(
                                    modifier = Modifier
                                        .fillMaxWidth()
                                        .padding(vertical = 80.dp),
                                    contentAlignment = Alignment.Center
                                ) {
                                    CircularProgressIndicator(color = Color(0xFF1DB954))
                                }
                            }
                        } else if (searchQuery.isNotBlank()) {
                            // حالت جستجو: نمایش تفکیک‌شده خواننده‌ها، آلبوم‌ها و آهنگ‌ها
                            if (filteredArtists.isNotEmpty()) {
                                item {
                                    SectionHeaderRow(
                                        title = "خوانندگان مرتبط (${filteredArtists.size})",
                                        actionText = null
                                    )
                                    LazyRow(
                                        contentPadding = PaddingValues(horizontal = 16.dp),
                                        horizontalArrangement = Arrangement.spacedBy(14.dp)
                                    ) {
                                        items(filteredArtists.take(15), key = { it.name }) { artist ->
                                            ArtistCircleItem(
                                                artist = artist,
                                                onClick = { currentSubScreen = OnlineSubScreen.ArtistDetail(artist) }
                                            )
                                        }
                                    }
                                    Spacer(modifier = Modifier.height(16.dp))
                                }
                            }

                            if (filteredAlbums.isNotEmpty()) {
                                item {
                                    SectionHeaderRow(
                                        title = "آلبوم‌های یافت‌شده (${filteredAlbums.size})",
                                        actionText = null
                                    )
                                    LazyRow(
                                        contentPadding = PaddingValues(horizontal = 16.dp),
                                        horizontalArrangement = Arrangement.spacedBy(14.dp)
                                    ) {
                                        items(filteredAlbums.take(15), key = { "${it.artist}_${it.title}" }) { album ->
                                            SpotifyAlbumCard(
                                                album = album,
                                                onClick = { currentSubScreen = OnlineSubScreen.AlbumDetail(album) }
                                            )
                                        }
                                    }
                                    Spacer(modifier = Modifier.height(16.dp))
                                }
                            }
                        } else {
                            // حالت عادی Spotify Explore (وقتی سرچ خالی است)

                            // ۳. بنر پیشنهاد ویژه از آرشیو تلگرام / کلادفلر
                            if (suggestedTracks.isNotEmpty() &&
                                (selectedCategory == OnlineFilterCategory.ALL || selectedCategory == OnlineFilterCategory.SUGGESTED)
                            ) {
                                item {
                                    SectionHeaderRow(
                                        title = "پیشنهاد ویژه از آرشیو تلگرام",
                                        subtitle = "انتخاب هوشمند برای شما از سرور کلادفلر"
                                    )
                                    LazyRow(
                                        contentPadding = PaddingValues(horizontal = 16.dp),
                                        horizontalArrangement = Arrangement.spacedBy(14.dp)
                                    ) {
                                        items(suggestedTracks.take(10), key = { "sug_${it.id}" }) { track ->
                                            SuggestedCloudTrackCard(
                                                track = track,
                                                isPlaying = currentPlayingTrack?.id == track.id,
                                                onClick = { onPlayTrack(track, suggestedTracks) }
                                            )
                                        }
                                    }
                                    Spacer(modifier = Modifier.height(22.dp))
                                }
                            }

                            // ۴. کروسل افقی خوانندگان محبوب (به‌جای ریختن همه خواننده‌ها زیر هم)
                            if (artistsList.isNotEmpty() &&
                                (selectedCategory == OnlineFilterCategory.ALL || selectedCategory == OnlineFilterCategory.ARTISTS)
                            ) {
                                item {
                                    SectionHeaderRow(
                                        title = "هنرمندان محبوب آرشیو",
                                        subtitle = "${artistsList.size} خواننده در آرشیو کلادفلر",
                                        actionText = "مشاهده همه",
                                        onActionClick = { currentSubScreen = OnlineSubScreen.AllArtistsGrid }
                                    )
                                    LazyRow(
                                        contentPadding = PaddingValues(horizontal = 16.dp),
                                        horizontalArrangement = Arrangement.spacedBy(16.dp)
                                    ) {
                                        items(artistsList.take(20), key = { "art_${it.name}" }) { artist ->
                                            ArtistCircleItem(
                                                artist = artist,
                                                onClick = { currentSubScreen = OnlineSubScreen.ArtistDetail(artist) }
                                            )
                                        }
                                    }
                                    Spacer(modifier = Modifier.height(24.dp))
                                }
                            }

                            // ۵. بخش آلبوم‌ها و مجموعه‌ها کنار هم به سبک Spotify
                            if (albumsList.isNotEmpty() &&
                                (selectedCategory == OnlineFilterCategory.ALL || selectedCategory == OnlineFilterCategory.ALBUMS)
                            ) {
                                item {
                                    SectionHeaderRow(
                                        title = "آلبوم‌ها و مجموعه‌ها",
                                        subtitle = "آهنگ‌های هر آلبوم یکجا کنار هم"
                                    )
                                    LazyRow(
                                        contentPadding = PaddingValues(horizontal = 16.dp),
                                        horizontalArrangement = Arrangement.spacedBy(14.dp)
                                    ) {
                                        items(albumsList.take(20), key = { "alb_${it.artist}_${it.title}" }) { album ->
                                            SpotifyAlbumCard(
                                                album = album,
                                                onClick = { currentSubScreen = OnlineSubScreen.AlbumDetail(album) }
                                            )
                                        }
                                    }
                                    Spacer(modifier = Modifier.height(24.dp))
                                }
                            }
                        }

                        // ۶. لیست صفحه‌بندی‌شده آهنگ‌ها (جلوگیری از شلوغی ۵۰۰۰+ آهنگ زیر هم)
                        item {
                            SectionHeaderRow(
                                title = if (searchQuery.isBlank()) "مرور آهنگ‌های آرشیو (${filteredTracks.size})"
                                else "آهنگ‌های یافت‌شده (${filteredTracks.size})",
                                subtitle = "بارگذاری هوشمند و سریع بدون کندی",
                                actionText = if (filteredTracks.isNotEmpty()) "پخش تصادفی همه" else null,
                                onActionClick = {
                                    if (filteredTracks.isNotEmpty()) {
                                        val shuffled = filteredTracks.shuffled()
                                        onPlayTrack(shuffled.first(), shuffled)
                                    }
                                }
                            )
                        }

                        val displayedTracks = filteredTracks.take(visibleTrackCount)
                        items(displayedTracks, key = { "trk_${it.id}" }) { track ->
                            SpotifyCompactTrackRow(
                                track = track,
                                isPlaying = currentPlayingTrack?.id == track.id,
                                onClick = { onPlayTrack(track, filteredTracks) }
                            )
                        }

                        if (visibleTrackCount < filteredTracks.size) {
                            item {
                                Box(
                                    modifier = Modifier
                                        .fillMaxWidth()
                                        .padding(16.dp),
                                    contentAlignment = Alignment.Center
                                ) {
                                    OutlinedButton(
                                        onClick = {
                                            visibleTrackCount = (visibleTrackCount + 50).coerceAtMost(filteredTracks.size)
                                        },
                                        shape = RoundedCornerShape(50),
                                        colors = ButtonDefaults.outlinedButtonColors(contentColor = Color(0xFF1DB954))
                                    ) {
                                        Text("نمایش آهنگ‌های بیشتر (${filteredTracks.size - visibleTrackCount} باقی‌مانده)")
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

