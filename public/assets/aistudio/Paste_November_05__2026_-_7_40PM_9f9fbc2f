 * دیگر هرگز بر اساس حروف الفبا (یا اولین/آخرین اسم فارسی) آهنگ را ثابت انتخاب نمی‌کند!
 * اولویت ۱: آهنگی که همین الان در حال پخش است
 * اولویت ۲: آخرین آهنگی که کاربر گوش داده است
 * اولویت ۳: انتخاب تصادفی هوشمند از ترکیب آهنگ‌های کاربر و پیشنهادهای کلادفلر در هر بار ورود
 */
@Composable
fun rememberSmartHeroTrack(
    currentPlayingTrack: Track?,
    recentlyPlayedTracks: List<Track>,
    localTracks: List<Track>,
    cloudflareTracks: List<Track> = CloudflareArchiveCache.cachedTracks
): Track? {
    val sessionRandomTrack = remember(localTracks.size, cloudflareTracks.size) {
        val combinedPool = (cloudflareTracks.take(50) + localTracks)
        combinedPool.shuffled().firstOrNull()
    }

    return currentPlayingTrack
        ?: recentlyPlayedTracks.firstOrNull()
        ?: sessionRandomTrack
}

