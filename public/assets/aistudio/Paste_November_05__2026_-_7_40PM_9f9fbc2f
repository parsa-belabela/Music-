/**
 * کش درون‌حافظه‌ای برای جلوگیری از درخواست‌های تکراری عکس آرتیست
 */
private val artistImageCache = ConcurrentHashMap<String, String>()

/**
 * دریافت عکس واقعی خواننده از سرویس‌های بدون فیلتر در ایران
 * ۱. ابتدا از طریق پراکسی کلادفلر خودتان (در صورت وجود مسیر) یا مستقیماً از iTunes / Deezer API
 * ۲. در صورت عدم وجود عکس، به هیچ عنوان از کاور آهنگ استفاده نمی‌کند و آواتار تایپوگرافی مدرن می‌سازد
 */
suspend fun fetchRealArtistImageUrl(
    artistName: String,
    cloudflareWorkerBaseUrl: String? = null
): String? = withContext(Dispatchers.IO) {
    val cleanName = artistName.trim()
    if (cleanName.isBlank() || cleanName.equals("Unknown Artist", ignoreCase = true) || cleanName == "خواننده ناشناس") {
        return@withContext null
    }

    artistImageCache[cleanName]?.let { cached ->
        return@withContext cached.ifEmpty { null }
    }

    val encodedName = try {
        URLEncoder.encode(cleanName, "UTF-8")
    } catch (e: Exception) {
        return@withContext null
    }

    // ۱. تلاش اول: استفاده از پراکسی کلادفلر (بدون فیلتر در ایران) برای دریافت تصویر آرتیست از Deezer
    val endpoints = buildList {
        if (!cloudflareWorkerBaseUrl.isNullOrBlank()) {
            add("${cloudflareWorkerBaseUrl.trimEnd('/')}/artist-image?name=$encodedName")
        }
        // API دیزر و آیتونز برای جستجوی تصویر رسمی خواننده
        add("https://api.deezer.com/search/artist?q=$encodedName&limit=1")
    }

    for (endpoint in endpoints) {
        try {
            val connection = (URL(endpoint).openConnection() as HttpURLConnection).apply {
                connectTimeout = 4500
                readTimeout = 4500
                requestMethod = "GET"
                setRequestProperty("Accept", "application/json")
            }

            if (connection.responseCode == 200) {
                val responseText = connection.inputStream.bufferedReader().use { it.readText() }
                val json = JSONObject(responseText)

                // اگر از ورکر مستقیم لینک عکس برگشت داده شد
                if (json.has("imageUrl")) {
                    val directUrl = json.optString("imageUrl")
                    if (directUrl.startsWith("http")) {
                        artistImageCache[cleanName] = directUrl
                        return@withContext directUrl
                    }
                }

                // ساختار پاسخ Deezer Artist API
                val dataArray = json.optJSONArray("data")
                if (dataArray != null && dataArray.length() > 0) {
                    val artistObj = dataArray.getJSONObject(0)
                    val pictureUrl = artistObj.optString("picture_big")
                        .ifEmpty { artistObj.optString("picture_medium") }
                    // جلوگیری از عکس خالی پیش‌فرض دیزر
                    if (pictureUrl.startsWith("http") && !pictureUrl.contains("/images/artist//")) {
                        artistImageCache[cleanName] = pictureUrl
                        return@withContext pictureUrl
                    }
                }
            }
        } catch (_: Exception) {
            // در صورت خطا یا محدودیت شبکه، سراغ آواتار تایپوگرافی مدرن می‌رویم
        }
    }

    artistImageCache[cleanName] = ""
    null
}

/**
 * کامپوننت آواتار خواننده به سبک Spotify
 * - اولویت اول: عکس واقعی خود خواننده (نه کاور آهنگ!)
 * - اولویت دوم (Fallback): طراحی تایپوگرافی مدرن که نام کامل خواننده را با گرادیان نئونی و فونت زیبا داخل قاب نمایش می‌دهد
 */
@Composable
fun SpotifyArtistAvatar(
    artistName: String,
    modifier: Modifier = Modifier,
    size: Dp = 88.dp,
    shape: Shape = CircleShape,
    explicitArtistImageUrl: String? = null,
    cloudflareWorkerBaseUrl: String? = null
) {
    var fetchedImageUrl by remember(artistName, explicitArtistImageUrl) {
        mutableStateOf(explicitArtistImageUrl ?: artistImageCache[artistName.trim()]?.takeIf { it.isNotEmpty() })
    }

    LaunchedEffect(artistName, explicitArtistImageUrl) {
        if (explicitArtistImageUrl.isNullOrBlank() && fetchedImageUrl == null) {
            fetchedImageUrl = fetchRealArtistImageUrl(artistName, cloudflareWorkerBaseUrl)
        }
    }

    Box(
        modifier = modifier
            .size(size)
            .clip(shape),
        contentAlignment = Alignment.Center
    ) {
        if (!fetchedImageUrl.isNullOrBlank()) {
            SubcomposeAsyncImage(
                model = fetchedImageUrl,
                contentDescription = artistName,
                contentScale = ContentScale.Crop,
                modifier = Modifier
                    .fillMaxSize()
                    .border(
                        width = 1.5.dp,
                        brush = Brush.linearGradient(
                            listOf(
                                Color(0xFF1DB954).copy(alpha = 0.7f),
                                Color.White.copy(alpha = 0.15f)
                            )
                        ),
                        shape = shape
                    ),
                loading = {
                    ModernTypographyArtistPlaceholder(artistName = artistName, size = size, shape = shape)
                },
                error = {
                    ModernTypographyArtistPlaceholder(artistName = artistName, size = size, shape = shape)
                }
            )
        } else {
            ModernTypographyArtistPlaceholder(artistName = artistName, size = size, shape = shape)
        }
    }
}

/**
 * پروفایل تایپوگرافی مدرن که اسم کامل خواننده را به شکل گرافیکی شیک داخل دایره/کارت می‌نویسد
 */
@Composable
fun ModernTypographyArtistPlaceholder(
    artistName: String,
    size: Dp,
    shape: Shape = CircleShape
) {
    val cleanName = artistName.trim().ifBlank { "Artist" }
    val hash = abs(cleanName.hashCode())

    val palettes = listOf(
        listOf(Color(0xFF0F2027), Color(0xFF203A43), Color(0xFF2C5364)),
        listOf(Color(0xFF1A0933), Color(0xFF3B185F), Color(0xFF7B2CBF)),
        listOf(Color(0xFF092014), Color(0xFF114B2F), Color(0xFF1DB954)),
        listOf(Color(0xFF2B0918), Color(0xFF590D22), Color(0xFFA4133C)),
        listOf(Color(0xFF0B132B), Color(0xFF1C2541), Color(0xFF3A506B)),
        listOf(Color(0xFF241505), Color(0xFF5C330A), Color(0xFFD97706))
    )
    val selectedColors = palettes[hash % palettes.size]

    val dynamicFontSize = when {
        size < 52.dp -> 10.sp
        size < 76.dp -> 12.sp
        size < 105.dp -> 14.sp
        else -> 18.sp
    }

    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(
                brush = Brush.linearGradient(selectedColors),
                shape = shape
            )
            .border(
                width = 1.5.dp,
                brush = Brush.sweepGradient(
                    listOf(
                        Color.White.copy(alpha = 0.35f),
                        selectedColors.last().copy(alpha = 0.8f),
                        Color.White.copy(alpha = 0.1f),
                        Color.White.copy(alpha = 0.35f)
                    )
                ),
                shape = shape
            )
            .padding(horizontal = 8.dp, vertical = 6.dp),
        contentAlignment = Alignment.Center
    ) {
        // هاله نوری ظریف پشت نوشته
        Box(
            modifier = Modifier
                .fillMaxSize(0.75f)
                .clip(RoundedCornerShape(50))
                .background(Color.White.copy(alpha = 0.05f))
        )

        Text(
            text = cleanName,
            color = Color.White,
            fontSize = dynamicFontSize,
            fontWeight = FontWeight.ExtraBold,
            textAlign = TextAlign.Center,
            maxLines = 2,
            lineHeight = (dynamicFontSize.value + 3).sp,
            overflow = TextOverflow.Ellipsis,
            style = MaterialTheme.typography.titleMedium
        )
    }
}

