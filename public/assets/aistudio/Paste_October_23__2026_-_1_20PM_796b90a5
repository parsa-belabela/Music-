    val cPrimary by animateColorAsState(slideAccent.first, tween(700), label = "storyPrimary")
    val cSecondary by animateColorAsState(slideAccent.second, tween(700), label = "storySecondary")

    Dialog(
        onDismissRequest = onDismiss,
