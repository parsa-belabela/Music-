                val w = size.width
                val h = size.height
                drawCircle(
                    brush = Brush.radialGradient(
                        colors = listOf(cPrimary.copy(alpha = 0.45f), Color.Transparent),
                        center = Offset(w * 0.5f, h * 0.35f),
                        radius = w * 0.85f
                    ),
                    radius = w * 0.85f,
