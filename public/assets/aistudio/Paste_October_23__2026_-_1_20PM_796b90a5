/**
 * دکمه اختصاصی برای Shuffle و Repeat با تشخیص خودکار روشنایی رنگ:
 * - وقتی غیرفعال است: نیمه‌شفاف با آیکون خاکستری روشن
 * - وقتی فعال است: دارای کادر درخشان، پس‌زمینه پررنگ با کنتراست تضمینی و نقطه نوری سبز/فیروزه‌ای در زیر آیکون (مشابه Spotify)
 *   تا حتی زمانی که رنگ کاور سفید خالص است، در یک نگاه کاملاً مشخص باشد که فعال است
 */
@Composable
private fun ModeToggleControlButton(
    icon: ImageVector,
    isActive: Boolean,
    badgeText: String? = null,
    primaryColor: Color,
    accentColor: Color,
    onClick: () -> Unit
) {
    val activeIndicatorColor = Color(0xFF00F5D4)
    val accentLum = (0.299f * accentColor.red + 0.587f * accentColor.green + 0.114f * accentColor.blue)
    val fillColor = if (accentLum > 0.78f) primaryColor else accentColor
    val fillLum = (0.299f * fillColor.red + 0.587f * fillColor.green + 0.114f * fillColor.blue)
    val activeIconTint = if (fillLum > 0.70f) Color(0xFF060812) else Color.White

    Box(
        modifier = Modifier
            .size(44.dp)
            .clip(CircleShape)
            .background(
                if (isActive) {
                    Brush.linearGradient(
                        listOf(
                            fillColor.copy(alpha = 0.92f),
                            primaryColor.copy(alpha = 0.85f)
                        )
                    )
                } else {
                    Brush.linearGradient(
                        listOf(
                            Color(0x33080A14),
                            Color(0x22FFFFFF)
                        )
                    )
                }
            )
            .border(
                width = if (isActive) 1.5.dp else 0.8.dp,
                color = if (isActive) activeIndicatorColor else Color.White.copy(alpha = 0.18f),
                shape = CircleShape
            )
            .clickable(onClick = onClick),
        contentAlignment = Alignment.Center
    ) {
        Column(
            horizontalAlignment = Alignment.CenterHorizontally,
            verticalArrangement = Arrangement.Center
        ) {
            Icon(
                imageVector = icon,
                contentDescription = null,
                tint = if (isActive) activeIconTint else Color.White.copy(alpha = 0.50f),
                modifier = Modifier.size(20.dp)
            )

            if (isActive) {
                Spacer(modifier = Modifier.height(2.dp))
                Box(
                    modifier = Modifier
                        .width(10.dp)
                        .height(3.dp)
                        .clip(CircleShape)
                        .background(if (fillLum > 0.70f) Color(0xFF060812) else activeIndicatorColor)
                )
            }
        }
    }
}

@Composable
private fun CoverReactivePlayButton(
    isPlaying: Boolean,
    primaryColor: Color,
    secondaryColor: Color,
    accentColor: Color,
    onClick: () -> Unit
) {
    val interactionSource = remember { MutableInteractionSource() }
    val isPressed by interactionSource.collectIsPressedAsState()
    val scale by animateFloatAsState(
        targetValue = if (isPressed) 0.90f else 1f,
        animationSpec = spring(
            dampingRatio = Spring.DampingRatioMediumBouncy,
            stiffness = Spring.StiffnessMedium
        ),
        label = "PlayOrbScale"
    )

    val luminance = (0.299f * primaryColor.red + 0.587f * primaryColor.green + 0.114f * primaryColor.blue)
    val iconColor = if (luminance > 0.72f) Color(0xFF090B14) else Color.White

    Box(
        modifier = Modifier.size(72.dp),
        contentAlignment = Alignment.Center
    ) {
        Canvas(modifier = Modifier.fillMaxSize()) {
            drawIntoCanvas { canvas ->
                val glowPaint = Paint().apply {
                    asFrameworkPaint().apply {
                        isAntiAlias = true
                        maskFilter = BlurMaskFilter(32f, BlurMaskFilter.Blur.NORMAL)
                        color = primaryColor.copy(alpha = 0.75f).toArgb()
                    }
                }
                canvas.drawCircle(
                    Offset(size.width / 2f, size.height / 2f),
                    size.minDimension / 2.1f,
                    glowPaint
                )
            }
        }

        Box(
            modifier = Modifier
                .size(64.dp)
                .scale(scale)
                .clip(CircleShape)
                .background(
                    Brush.linearGradient(
                        colors = listOf(
                            primaryColor,
                            accentColor.copy(alpha = 0.90f),
                            secondaryColor
                        )
                    )
                )
                .border(
                    width = 1.6.dp,
                    brush = Brush.verticalGradient(
                        listOf(
                            Color.White.copy(alpha = 0.85f),
                            Color.White.copy(alpha = 0.25f)
                        )
                    ),
                    shape = CircleShape
                )
                .clickable(
                    interactionSource = interactionSource,
                    indication = null,
                    onClick = onClick
                )
                .testTag("play_pause_button"),
            contentAlignment = Alignment.Center
        ) {
            Icon(
                imageVector = if (isPlaying) Icons.Default.Pause else Icons.Default.PlayArrow,
                contentDescription = if (isPlaying) "Pause" else "Play",
                tint = iconColor,
                modifier = Modifier.size(34.dp)
            )
        }
    }
}

@Composable
private fun LiveCoverEnergyBars(
    isPlaying: Boolean,
    bass: Float,
    kick: Float,
    primaryColor: Color,
    accentColor: Color
) {
    val transition = rememberInfiniteTransition(label = "CrispEnergyBars")
    val w1 by transition.animateFloat(
        initialValue = 0.22f,
        targetValue = 0.98f,
        animationSpec = infiniteRepeatable(tween(210, easing = FastOutSlowInEasing), RepeatMode.Reverse),
        label = "w1"
    )
    val w2 by transition.animateFloat(
        initialValue = 0.35f,
        targetValue = 1.0f,
        animationSpec = infiniteRepeatable(tween(165, easing = FastOutSlowInEasing), RepeatMode.Reverse),
        label = "w2"
    )
    val w3 by transition.animateFloat(
        initialValue = 0.18f,
        targetValue = 0.92f,
        animationSpec = infiniteRepeatable(tween(250, easing = FastOutSlowInEasing), RepeatMode.Reverse),
        label = "w3"
    )
    val w4 by transition.animateFloat(
        initialValue = 0.28f,
        targetValue = 0.96f,
        animationSpec = infiniteRepeatable(tween(190, easing = FastOutSlowInEasing), RepeatMode.Reverse),
        label = "w4"
    )

    val boost = (bass * 0.35f + kick * 0.25f).coerceIn(0f, 0.45f)
    val heights = if (isPlaying) {
        listOf(
            (w1 * 0.75f + boost).coerceIn(0.20f, 1f),
            (w2 * 0.80f + boost).coerceIn(0.24f, 1f),
            (w3 * 0.75f + boost).coerceIn(0.20f, 1f),
            (w4 * 0.78f + boost).coerceIn(0.22f, 1f)
        )
    } else {
        listOf(0.22f, 0.22f, 0.22f, 0.22f)
    }

    Canvas(
        modifier = Modifier
            .width(22.dp)
            .height(18.dp)
    ) {
        val barCount = heights.size
        val barWidth = 3.2.dp.toPx()
        val spacing = (size.width - (barCount * barWidth)) / (barCount - 1).coerceAtLeast(1)

        heights.forEachIndexed { idx, ratio ->
            val barH = (size.height * ratio).coerceAtLeast(barWidth)
            val x = idx * (barWidth + spacing)
            val y = (size.height - barH) / 2f
            val corner = CornerRadius(barWidth / 2f, barWidth / 2f)

            drawRoundRect(
                color = Color(0xCC05070E),
                topLeft = Offset(x - 1.dp.toPx(), y - 1.dp.toPx()),
                size = Size(barWidth + 2.dp.toPx(), barH + 2.dp.toPx()),
                cornerRadius = CornerRadius((barWidth + 2.dp.toPx()) / 2f)
            )

            drawRoundRect(
                brush = Brush.verticalGradient(
                    colors = listOf(
                        Color.White,
                        accentColor,
                        primaryColor
                    ),
                    startY = y,
                    endY = y + barH
                ),
                topLeft = Offset(x, y),
                size = Size(barWidth, barH),
                cornerRadius = corner
            )
        }
    }
}

@Composable
private fun SegmentPillItem(
    title: String,
    isSelected: Boolean,
    activeColor: Color,
    onClick: () -> Unit
) {
    val lum = (0.299f * activeColor.red + 0.587f * activeColor.green + 0.114f * activeColor.blue)
    val selectedTextColor = if (lum > 0.72f) Color(0xFF090B14) else Color.White

    Box(
        modifier = Modifier
            .clip(RoundedCornerShape(24.dp))
            .background(if (isSelected) activeColor else Color.Transparent)
            .clickable { onClick() }
            .padding(horizontal = 15.dp, vertical = 6.dp),
        contentAlignment = Alignment.Center
    ) {
        Text(
            text = title,
            color = if (isSelected) selectedTextColor else Color(0xFFB0B6CA),
            fontWeight = if (isSelected) FontWeight.ExtraBold else FontWeight.Medium,
            fontSize = 12.sp
        )
    }
}

