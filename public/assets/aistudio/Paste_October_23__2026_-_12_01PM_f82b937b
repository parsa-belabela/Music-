/**
 * نوار پیشرفت هماهنگ با رنگ کاور آهنگ:
 * - حذف کامل رنگ‌های چندگانه دی‌جی (قرمز/آبی/سبز)
 * - استفاده مستقیم از رنگ کاور آهنگ (palette.primary و palette.accent)
 * - دارای شیار محافظ تیره (Contrast Casing) و هسته سفید-نوری تا هرگز با رنگ‌های پس‌زمینه یکی و محو نشود
 */
@Composable
fun LiquidGlassProgressBar(
    currentPositionProvider: () -> Long,
    durationMs: Long,
    palette: AmbientPalette,
    analysisDataProvider: () -> AudioAnalysisData = { AudioAnalysisData() },
    onSeekTo: (Long) -> Unit,
    waveformEnvelope: FloatArray? = null,
    loopStartMs: Long? = null,
    loopEndMs: Long? = null,
    modifier: Modifier = Modifier
) {
    var isDragging by remember { mutableStateOf(false) }
    var dragProgress by remember { mutableFloatStateOf(0f) }
    var ignoreExternalSyncUntilMs by remember { mutableLongStateOf(0L) }
    var componentWidthPx by remember { mutableFloatStateOf(1f) }

    val currentDurationMs by rememberUpdatedState(durationMs)
    val currentOnSeekTo by rememberUpdatedState(onSeekTo)
    val currentPositionProviderUpdated by rememberUpdatedState(currentPositionProvider)

    var internalCurrentMs by remember { mutableLongStateOf(currentPositionProvider()) }

    val coverPrimary by animateColorAsState(
        targetValue = palette.primary,
        animationSpec = tween(500),
        label = "barCoverPrimary"
    )
    val coverAccent by animateColorAsState(
        targetValue = palette.accent,
        animationSpec = tween(500),
        label = "barCoverAccent"
    )

    LaunchedEffect(durationMs) {
        internalCurrentMs = currentPositionProviderUpdated()
        dragProgress = 0f
        ignoreExternalSyncUntilMs = 0L
    }

    LaunchedEffect(isDragging) {
        if (!isDragging) {
            while (true) {
                if (System.currentTimeMillis() > ignoreExternalSyncUntilMs) {
                    internalCurrentMs = currentPositionProviderUpdated()
                }
                delay(16L)
            }
        }
    }

    val safeDuration = currentDurationMs.coerceAtLeast(1L)
    val effectiveMs = if (isDragging) (dragProgress * safeDuration).toLong() else internalCurrentMs
    val displayedProgress = (effectiveMs.toFloat() / safeDuration.toFloat()).coerceIn(0f, 1f)

    val trackHeight by animateDpAsState(
        targetValue = if (isDragging) 9.5.dp else 6.dp,
        animationSpec = spring(stiffness = Spring.StiffnessMediumLow),
        label = "trackHeight"
    )

    val thumbRadiusDp by animateDpAsState(
        targetValue = if (isDragging) 10.dp else 7.dp,
        animationSpec = spring(dampingRatio = Spring.DampingRatioMediumBouncy, stiffness = Spring.StiffnessMedium),
        label = "thumbRadius"
    )

    val haloExpansion by animateFloatAsState(
        targetValue = if (isDragging) 1.0f else 0.0f,
        animationSpec = tween(180),
        label = "haloExpansion"
    )

    CompositionLocalProvider(LocalLayoutDirection provides LayoutDirection.Ltr) {
        Column(
            modifier = modifier
                .fillMaxWidth()
                .padding(vertical = 4.dp)
        ) {
            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .height(42.dp)
                    .onSizeChanged { size ->
                        componentWidthPx = size.width.toFloat().coerceAtLeast(1f)
                    }
                    .pointerInput(safeDuration) {
                        awaitEachGesture {
                            val down = awaitFirstDown(requireUnconsumed = false)
                            down.consume()
                            isDragging = true
                            val width = componentWidthPx.coerceAtLeast(1f)
                            val initialFraction = (down.position.x / width).coerceIn(0f, 0.992f)
                            dragProgress = initialFraction
                            val curSafeDur = currentDurationMs.coerceAtLeast(1L)
                            internalCurrentMs = (initialFraction * curSafeDur).toLong()

                            var activePointerId = down.id
                            while (true) {
                                val event = awaitPointerEvent()
                                val pointer = event.changes.firstOrNull { it.id == activePointerId }
                                    ?: event.changes.firstOrNull()
                                if (pointer == null || !pointer.pressed) {
                                    pointer?.consume()
                                    break
                                }
                                activePointerId = pointer.id
                                if (pointer.positionChange() != Offset.Zero) {
                                    pointer.consume()
                                }
                                val newFraction = (pointer.position.x / width).coerceIn(0f, 0.992f)
                                dragProgress = newFraction
                                internalCurrentMs = (newFraction * curSafeDur).toLong()
                            }

                            val maxSafeSeek = if (curSafeDur > 1500L) curSafeDur - 900L else curSafeDur
                            val targetMs = (dragProgress * curSafeDur).toLong().coerceIn(0L, maxSafeSeek)
                            internalCurrentMs = targetMs
                            ignoreExternalSyncUntilMs = System.currentTimeMillis() + 350L
                            isDragging = false
                            currentOnSeekTo(targetMs)
                        }
                    }
                    .testTag("seek_slider"),
                contentAlignment = Alignment.Center
            ) {
                Canvas(
                    modifier = Modifier
                        .fillMaxWidth()
                        .height(30.dp)
                ) {
                    val w = size.width
                    val h = size.height
                    val centerY = h / 2f
                    val activeWidth = (w * displayedProgress).coerceIn(0f, w)
                    val trackH = trackHeight.toPx()
                    val corner = CornerRadius(trackH / 2f, trackH / 2f)
                    val trackTop = centerY - (trackH / 2f)

                    // ۱. قاب محافظ کنتراست تیره (Dark Contrast Casing) در زیر نوار
                    // تضمین می‌کند حتی اگر پس‌زمینه دقیقاً هم‌رنگ کاور یا سفید باشد، نوار کاملاً تفکیک و مشخص بماند
                    val casingPadding = 2.dp.toPx()
                    drawRoundRect(
                        color = Color(0xB805070E),
                        topLeft = Offset(0f, trackTop - casingPadding),
                        size = Size(w, trackH + casingPadding * 2f),
                        cornerRadius = CornerRadius((trackH + casingPadding * 2f) / 2f)
                    )

                    // ۲. شیار پس‌زمینه شیشه‌ای نوار
                    drawRoundRect(
                        color = Color(0x38FFFFFF),
                        topLeft = Offset(0f, trackTop),
                        size = Size(w, trackH),
                        cornerRadius = corner
                    )

                    // خط مرزی ظریف دور کل شیار نوار برای جلوگیری از محو شدن
                    drawRoundRect(
                        color = Color.White.copy(alpha = 0.28f),
                        topLeft = Offset(0f, trackTop),
                        size = Size(w, trackH),
                        cornerRadius = corner,
                        style = Stroke(width = 1.dp.toPx())
                    )

                    // ۳. بخش پرشده نوار بر اساس رنگ کاور آهنگ (همراه با لبه روشن کریستالی)
                    if (activeWidth > 0f) {
                        val glowHeight = trackH * (2.2f + haloExpansion * 0.5f)
                        val glowTop = centerY - (glowHeight / 2f)

                        drawRoundRect(
                            brush = Brush.horizontalGradient(
                                colors = listOf(
                                    coverPrimary.copy(alpha = 0.45f),
                                    coverAccent.copy(alpha = 0.65f)
                                ),
                                startX = 0f,
                                endX = activeWidth.coerceAtLeast(1f)
                            ),
                            topLeft = Offset(0f, glowTop),
                            size = Size(activeWidth, glowHeight),
                            cornerRadius = CornerRadius(glowHeight / 2f, glowHeight / 2f)
                        )

                        // بدنه اصلی نوار پرشده با رنگ کاور + هسته درخشان در نوک نوار
                        drawRoundRect(
                            brush = Brush.horizontalGradient(
                                colorStops = arrayOf(
                                    0.00f to coverPrimary,
                                    0.75f to coverAccent,
                                    1.00f to Color.White
                                ),
                                startX = 0f,
                                endX = activeWidth.coerceAtLeast(1f)
                            ),
                            topLeft = Offset(0f, trackTop),
                            size = Size(activeWidth, trackH),
                            cornerRadius = corner
                        )

                        // هایلایت سفید بسیار ظریف روی لبه بالایی قسمت پرشده برای تفکیک از پس‌زمینه
                        drawRoundRect(
                            color = Color.White.copy(alpha = 0.45f),
                            topLeft = Offset(0f, trackTop),
                            size = Size(activeWidth, trackH),
                            cornerRadius = corner,
                            style = Stroke(width = 0.9.dp.toPx())
                        )
                    }

                    // نمایش بازه Loop A-B در صورت فعال بودن
                    if (loopStartMs != null && loopStartMs >= 0L) {
                        val startX = ((loopStartMs.toFloat() / safeDuration.toFloat()).coerceIn(0f, 1f)) * w
                        drawCircle(
                            color = Color.White,
                            radius = trackH * 0.8f,
                            center = Offset(startX, centerY)
                        )
                        if (loopEndMs != null && loopEndMs > loopStartMs) {
                            val endX = ((loopEndMs.toFloat() / safeDuration.toFloat()).coerceIn(0f, 1f)) * w
                            drawRoundRect(
                                color = Color.White.copy(alpha = 0.30f),
                                topLeft = Offset(startX, trackTop - 2.dp.toPx()),
                                size = Size((endX - startX).coerceAtLeast(2f), trackH + 4.dp.toPx()),
                                cornerRadius = corner
                            )
                            drawCircle(
                                color = Color.White,
                                radius = trackH * 0.8f,
                                center = Offset(endX, centerY)
                            )
                        }
                    }

                    // ۴. گوی نوری سر نوار (Thumb) با حلقه محافظ تیره + مرکز سفید و رنگی
                    val thumbCenter = Offset(activeWidth.coerceIn(0f, w), centerY)
                    val thumbRadiusPx = thumbRadiusDp.toPx()

                    drawCircle(
                        brush = Brush.radialGradient(
                            colors = listOf(
                                coverAccent.copy(alpha = 0.70f),
                                coverPrimary.copy(alpha = 0.30f),
                                Color.Transparent
                            ),
                            center = thumbCenter,
                            radius = thumbRadiusPx * 2.4f
                        ),
                        radius = thumbRadiusPx * 2.4f,
                        center = thumbCenter
                    )

                    // حلقه سایه تیره دور گوی تا روی پس‌زمینه روشن هم ۱۰۰٪ مشخص باشد
                    drawCircle(
                        color = Color(0xD905070E),
                        radius = thumbRadiusPx + 2.dp.toPx(),
                        center = thumbCenter
                    )

                    // حلقه سفید بیرونی گوی
                    drawCircle(
                        color = Color.White,
                        radius = thumbRadiusPx,
                        center = thumbCenter
                    )

                    // هسته رنگی کاور در مرکز گوی
                    drawCircle(
                        color = coverAccent,
                        radius = thumbRadiusPx * 0.55f,
                        center = thumbCenter
                    )
                }
            }

            Row(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(horizontal = 2.dp),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text(
                    text = formatDuration(effectiveMs),
                    style = MaterialTheme.typography.bodySmall.copy(
                        color = if (isDragging) Color.White else Color(0xFFD0D6EA),
                        fontSize = 12.sp,
                        fontWeight = FontWeight.Bold
                    )
                )

                Text(
                    text = "-${formatDuration((safeDuration - effectiveMs).coerceAtLeast(0L))}",
                    style = MaterialTheme.typography.bodySmall.copy(
                        color = Color(0xFFD0D6EA),
                        fontSize = 12.sp,
                        fontWeight = FontWeight.Bold
                    )
                )
            }
        }
    }
}

@Composable
fun LiquidGlassProgressBar(
    progress: Float,
    onSeek: (Float) -> Unit,
    palette: AmbientPalette = AmbientPalette(),
    waveformEnvelope: FloatArray? = null,
    modifier: Modifier = Modifier,
    primaryColor: Color = palette.primary,
    secondaryColor: Color = palette.accent,
    durationMs: Long = 180000L,
    currentPositionMs: Long = (progress * durationMs).toLong()
) {
    val safeDur = durationMs.coerceAtLeast(1L)
    val mergedPalette = palette.copy(primary = primaryColor, accent = secondaryColor)
    LiquidGlassProgressBar(
        currentPositionProvider = { currentPositionMs },
        durationMs = safeDur,
        palette = mergedPalette,
        analysisDataProvider = { AudioAnalysisData() },
        onSeekTo = { ms -> onSeek((ms.toFloat() / safeDur.toFloat()).coerceIn(0f, 1f)) },
        waveformEnvelope = waveformEnvelope,
        modifier = modifier
    )
}

private fun formatDuration(ms: Long): String {
    val totalSeconds = (ms / 1000).coerceAtLeast(0)
    val minutes = totalSeconds / 60
    val seconds = totalSeconds % 60
    return "%d:%02d".format(minutes, seconds)
}

۴. اصلاح کامل منطق Gym Mode و بازگرداندن تنظیمات اکولایزر پس از خاموش کردن در MusicPlayerViewModel.kt
مسیر فایل: app/src/main/java/com/example/ui/viewmodel/MusicPlayerViewModel.kt
کد زیر را جایگزین کنید:
(در فایل MusicPlayerViewModel.kt، متد toggleGymMode یا بخش مدیریت حالت باشگاه/تمرکز را با کد زیر جایگزین کنید تا هنگام روشن شدن، فقط آهنگ‌های واقعاً پرانرژی و مناسب باشگاه انتخاب شوند و به محض خاموش شدن، اکولایزر، بیس‌بوست، کراس‌فید و لیست پخش دقیقاً به حالت قبلی شما برگردند)
    // متغیرهای ذخیره وضعیت دقیق کاربر قبل از روشن کردن حالت باشگاه (Gym Mode Snapshot)
    private var preGymEqEnabled: Boolean? = null
    private var preGymEqPreset: String? = null
    private var preGymEqBands: List<Float>? = null
    private var preGymBassBoost: Int? = null
    private var preGymCrossfade: Int? = null
    private var preGymQueue: List<Track>? = null

    /**
     * روشن/خاموش کردن هوشمند حالت باشگاه (Gym Mode):
     * ۱. هنگام روشن شدن: تنظیمات فعلی اکولایزر و بیس کاربر را ذخیره می‌کند، سپس آهنگ‌های واقعاً پرانرژی و تند (BPM بالا، رپ، هیپ‌هاپ، فونک، الکترونیک و...) را انتخاب و ردیف می‌کند و پروفایل صوتی باشگاه را فعال می‌نماید.
     * ۲. هنگام خاموش شدن: تمام تغییرات اکولایزر، بیس‌بوست، کراس‌فید و صف پخش را ۱۰۰٪ به حالت قبلی کاربر برمی‌گرداند تا صدای آهنگ‌های عادی خراب نشود.
     */
    fun toggleGymMode() {
        val current = _appSettings.value
        val enablingGym = !current.gymModeEnabled

        if (enablingGym) {
            val prefs = app.getSharedPreferences("aura_gym_backup", Context.MODE_PRIVATE)
            // ۱. ذخیره دقیق تنظیمات صوتی فعلی کاربر قبل از اعمال پروفایل باشگاه
            preGymEqEnabled = current.equalizerEnabled
            preGymEqPreset = current.eqPreset
            preGymEqBands = current.eqBands
            preGymBassBoost = current.bassBoostStrength
            preGymCrossfade = current.crossfadeDurationSeconds
            preGymQueue = _playbackState.value.queue

            prefs.edit()
                .putBoolean("has_backup", true)
                .putBoolean("eq_enabled", current.equalizerEnabled)
                .putString("eq_preset", current.eqPreset)
                .putString("eq_bands", current.eqBands.joinToString(","))
                .putInt("bass_boost", current.bassBoostStrength)
                .putInt("crossfade", current.crossfadeDurationSeconds)
                .apply()

            // ۲. اعمال پروفایل صوتی مخصوص باشگاه (تقویت کوبندگی بیس و شفافیت بدون خراب کردن صدا)
            val gymBands = listOf(7.5f, 6.5f, 4.5f, 1.5f, 0.0f, 1.0f, 2.5f, 3.5f, 4.5f, 4.5f)
            val gymSettings = current.copy(
                gymModeEnabled = true,
                focusModeEnabled = false,
                equalizerEnabled = true,
                eqPreset = "Gym & 808 Punch",
                eqBands = gymBands,
                bassBoostStrength = 600,
                crossfadeDurationSeconds = 2,
                gaplessEnabled = true
            )
            updateSettings(gymSettings)

            // ۳. انتخاب هوشمند و دقیق آهنگ‌های مناسب باشگاه بر اساس BPM، سطح انرژی و سبک واقعی
            viewModelScope.launch(kotlinx.coroutines.Dispatchers.IO) {
                val all = allTracks.value
                if (all.isEmpty()) return@launch

                val profilesMap = repository.getAudioProfiles(all.map { it.id }).associateBy { it.trackId }

                val scoredGymTracks = all.mapNotNull { track ->
                    val profile = profilesMap[track.id]
                    val score = calculateGymSuitabilityScore(track, profile)
                    if (score >= 45) track to score else null
                }.sortedByDescending { it.second }.map { it.first }

                val finalGymQueue = if (scoredGymTracks.size >= 3) {
                    scoredGymTracks
                } else {
                    // اگر هنوز پروفایل همه آهنگ‌ها آنالیز نشده بود، بر اساس امتیاز کلی مرتب کن
                    all.sortedByDescending { trk -> calculateGymSuitabilityScore(trk, profilesMap[trk.id]) }
                        .take(25.coerceAtMost(all.size))
                }

                kotlinx.coroutines.withContext(kotlinx.coroutines.Dispatchers.Main) {
                    if (finalGymQueue.isNotEmpty()) {
                        val currentPlaying = _playbackState.value.currentTrack
                        // اگر آهنگ فعلی خودش جزو آهنگ‌های پرانرژی باشگاه است، همان را ادامه بده و بقیه صف را آپدیت کن؛ وگرنه اولین آهنگ پرانرژی باشگاه را پخش کن
                        if (currentPlaying != null && finalGymQueue.any { it.id == currentPlaying.id } && _playbackState.value.isPlaying) {
                            val reordered = listOf(currentPlaying) + finalGymQueue.filter { it.id != currentPlaying.id }
                            originalQueue = reordered
                            _playbackState.update { it.copy(queue = reordered, queueIndex = 0) }
                        } else {
                            playTrack(finalGymQueue.first(), finalGymQueue)
                        }
                    }
                }
            }
        } else {
            // خاموش کردن حالت باشگاه و بازگرداندن ۱۰۰٪ تنظیمات قبلی اکولایزر، بیس و کراس‌فید
            val prefs = app.getSharedPreferences("aura_gym_backup", Context.MODE_PRIVATE)
            val restoredEqEnabled = preGymEqEnabled ?: prefs.getBoolean("eq_enabled", true)
            val restoredEqPreset = preGymEqPreset ?: prefs.getString("eq_preset", "Flat (Studio)") ?: "Flat (Studio)"
            val restoredBassBoost = preGymBassBoost ?: prefs.getInt("bass_boost", 0)
            val restoredCrossfade = preGymCrossfade ?: prefs.getInt("crossfade", 2)
            val restoredBands = preGymEqBands ?: run {
                val savedStr = prefs.getString("eq_bands", null)
                if (!savedStr.isNullOrBlank()) {
                    savedStr.split(",").mapNotNull { it.toFloatOrNull() }.takeIf { it.size == 10 }
                } else null
            } ?: listOf(0f, 0f, 0f, 0f, 0f, 0f, 0f, 0f, 0f, 0f)

            val restoredSettings = current.copy(
                gymModeEnabled = false,
                equalizerEnabled = restoredEqEnabled,
                eqPreset = restoredEqPreset,
                eqBands = restoredBands,
                bassBoostStrength = restoredBassBoost,
                crossfadeDurationSeconds = restoredCrossfade
            )

            // اعمال فوری تنظیمات بازگردانی‌شده به موتور صوتی تا صدای آهنگ به حالت طبیعی برگردد
            updateSettings(restoredSettings)
            audioEngine.applyEqualizerSettings(
                enabled = restoredEqEnabled,
                bands = restoredBands,
                bassBoostStrength = restoredBassBoost
            )

            // بازگرداندن صف پخش قبلی بدون قطع کردن آهنگ در حال پخش
            val previousQ = preGymQueue?.takeIf { it.isNotEmpty() } ?: allTracks.value
            val currentTrack = _playbackState.value.currentTrack
            if (previousQ.isNotEmpty()) {
                val newIdx = if (currentTrack != null) {
                    previousQ.indexOfFirst { it.id == currentTrack.id }.coerceAtLeast(0)
                } else 0
                originalQueue = previousQ
                _playbackState.update {
                    it.copy(queue = previousQ, queueIndex = newIdx)
                }
            }

            prefs.edit().putBoolean("has_backup", false).apply()
            preGymEqEnabled = null
            preGymEqPreset = null
            preGymEqBands = null
            preGymBassBoost = null
            preGymCrossfade = null
            preGymQueue = null
        }
    }

    /**
     * الگوریتم امتیازدهی دقیق برای تشخیص آهنگ‌های مناسب تمرین و باشگاه (Gym Suitability Score)
     */
    private fun calculateGymSuitabilityScore(track: Track, profile: TrackAudioProfile?): Int {
        var score = 0
        val text = "${track.title} ${track.artist} ${track.album} ${track.genre}".lowercase()

        // ۱. حذف فوری آهنگ‌های آرام، لالایی، پیانو، مدیتیشن یا بسیار کوتاه/طولانی
        val slowKeywords = listOf(
            "sleep", "lullaby", "meditation", "relax", "calm", "ambient", "piano",
            "acoustic", "sad", "ballad", "study", "rain", "nature", "خواب", "آرامش", "لایت", "غمگین", "دکلمه"
        )
        if (slowKeywords.any { text.contains(it) } || track.isInstrumental) {
            score -= 60
        }

        // ۲. بررسی پروفایل صوتی تحلیل‌شده (BPM و سطح انرژی واقعی فایل صوتی)
        if (profile != null) {
            val bpm = profile.estimatedTempoBpm ?: 105
            when {
                bpm in 115..165 -> score += 45
                bpm in 100..114 || bpm > 165 -> score += 28
                bpm < 90 -> score -= 35
            }

            when {
                profile.energyLevel >= 0.72f -> score += 45
                profile.energyLevel >= 0.58f -> score += 30
                profile.energyLevel < 0.42f -> score -= 30
            }

            if (profile.tempoBucket == "FAST") score += 25
            else if (profile.tempoBucket == "SLOW") score -= 35
        } else {
            score += 20
        }

        // ۳. بررسی سبک‌ها و هنرمندان پرانرژی (Hip-Hop, Rap, Trap, Drill, Phonk, EDM, Rock)
        val hypeKeywords = listOf(
            "hip-hop", "hip hop", "rap", "trap", "drill", "phonk", "gym", "workout",
            "edm", "club", "remix", "bass", "hard", "rock", "metal", "techno", "house",
            "kanye", "travis", "future", "metro boomin", "kendrick", "j. cole", "juice wrld",
            "nemzzz", "21 savage", "drake", "eminem", "pop smoke", "playboi",
            "رپ", "هیپ‌هاپ", "تتلو", "حصین", "شایع", "پیشرو", "زدبازی", "هیدن", "پوتک", "فدایی", "چرسی", "دیس"
        )
        if (hypeKeywords.any { text.contains(it) }) {
            score += 40
        }

        // ۴. اولویت به آهنگ‌های محبوب کاربر که انرژی بالایی دارند
        if (track.isFavorite) score += 15
        score += (track.playCount * 3).coerceAtMost(24)

        // ۵. مدت زمان استاندارد آهنگ تمرینی (۱.۵ تا ۶ دقیقه)
        if (track.durationMs in 90_000L..360_000L) {
            score += 10
        } else {
            score -= 20
        }

        return score
    }

