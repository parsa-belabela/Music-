data class OnlineSongResult(
    val id: String,
    val title: String,
    val artist: String,
    val album: String,
    val durationSec: Int,
    val streamUrl: String,
    val downloadUrl: String,
    val coverUrl: String,
    val artistPicUrl: String = ""
)

data class OnlineArtistItem(
    val name: String,
    val trackCount: Int,
    val coverUrl: String
)

fun OnlineSongResult.toAppTrack(): Track {
    val stableId = -Math.abs(id.hashCode().toLong().let { if (it == 0L) 999999L else it })
    return Track(
        id = stableId,
        title = title,
        artist = artist,
        album = album.ifBlank { "Single" },
        duration = durationSec.coerceAtLeast(1) * 1000L,
        path = streamUrl,
        uri = streamUrl,
        albumArtUri = coverUrl,
        dateAdded = System.currentTimeMillis() / 1000L,
        trackNumber = 0,
        year = 2026,
        size = 0L,
        mimeType = "audio/mpeg",
        bitrate = 320000,
        sampleRate = 44100
    )
}

object CloudflareCatalogClient {

    suspend fun fetchCatalog(
        context: Context,
        query: String = "",
        artistFilter: String? = null
    ): Result<Pair<List<OnlineSongResult>, List<OnlineArtistItem>>> = withContext(Dispatchers.IO) {
        try {
            val entitlement = EntitlementManager.getInstance(context)
            val baseUrl = EntitlementManager.CLOUDFLARE_WORKER_URL.trimEnd('/')
            val deviceId = entitlement.getHardwareDeviceId()
            val encodedQ = URLEncoder.encode(query.trim(), "UTF-8")
            val encodedArtist = URLEncoder.encode(artistFilter ?: "", "UTF-8")
            val fullUrl = "$baseUrl/tracks?q=$encodedQ&artist=$encodedArtist&deviceId=$deviceId"

            val conn = (URL(fullUrl).openConnection() as HttpURLConnection).apply {
                requestMethod = "GET"
                connectTimeout = 10000
                readTimeout = 10000
                setRequestProperty("X-Device-Id", deviceId)
                setRequestProperty("Accept", "application/json")
            }

            if (conn.responseCode !in 200..299) {
                return@withContext Result.failure(IllegalStateException("خطای سرور کلادفلر: کد ${conn.responseCode}"))
            }

            val raw = conn.inputStream.bufferedReader().use { it.readText() }
            val root = JSONObject(raw)

            val tracksArr: JSONArray = root.optJSONArray("tracks")
                ?: root.optJSONArray("data")
                ?: root.optJSONArray("results")
                ?: JSONArray()

            val parsedTracks = ArrayList<OnlineSongResult>(tracksArr.length())
            for (i in 0 until tracksArr.length()) {
                val obj = tracksArr.optJSONObject(i) ?: continue
                val id = obj.optString("id", "")
                if (id.isBlank()) continue

                val title = obj.optString("title", "Unknown Track")
                val artistObj = obj.optJSONObject("artist")
                val artistName = obj.optString("artist_name").ifBlank {
                    obj.optString("artistName").ifBlank {
                        artistObj?.optString("name") ?: obj.optString("artist", "Unknown Artist")
                    }
                }
                val albumName = obj.optString("album", "Single")
                    .let { if (it.startsWith("{") || it.contains("title=")) "Single" else it }

                val stream = obj.optString("stream_url").ifBlank {
                    obj.optString("streamUrl").ifBlank {
                        obj.optString("preview").ifBlank { "$baseUrl/stream?id=$id" }
                    }
                }
                val download = obj.optString("download_url").ifBlank { "$stream&dl=1" }
                val cover = obj.optString("cover_url").ifBlank {
                    obj.optString("coverUrl").ifBlank {
                        obj.optString("cover").ifBlank { "$baseUrl/cover?id=$id&v=hd6" }
                    }
                }
                val artistPic = obj.optString("artist_picture").ifBlank {
                    artistObj?.optString("picture")
                        ?: "$baseUrl/artist-cover?name=${URLEncoder.encode(artistName, "UTF-8")}&id=$id&v=hd6"
                }

                parsedTracks.add(
                    OnlineSongResult(
                        id = id,
                        title = title,
                        artist = artistName,
                        album = albumName,
                        durationSec = obj.optInt("duration", 200),
                        streamUrl = stream,
                        downloadUrl = download,
                        coverUrl = cover,
                        artistPicUrl = artistPic
                    )
                )
            }

            val artistsArr = root.optJSONArray("artists") ?: JSONArray()
            val parsedArtists = ArrayList<OnlineArtistItem>(artistsArr.length())
            for (j in 0 until artistsArr.length()) {
                val aObj = artistsArr.optJSONObject(j) ?: continue
                val name = aObj.optString("name", "")
                if (name.isBlank()) continue
                val pic = aObj.optString("picture").ifBlank {
                    aObj.optString("cover").ifBlank {
                        "$baseUrl/artist-cover?name=${URLEncoder.encode(name, "UTF-8")}&v=hd6"
                    }
                }
                parsedArtists.add(
                    OnlineArtistItem(
                        name = name,
                        trackCount = aObj.optInt("trackCount", 1),
                        coverUrl = pic
                    )
                )
            }

            Result.success(parsedTracks to parsedArtists)
        } catch (e: Exception) {
            Result.failure(e)
        }
    }
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun OnlineMusicScreen(
    onPlayStream: (url: String, title: String, artist: String, coverUrl: String, durationSec: Int) -> Unit = { _, _, _, _, _ -> },
    onPlayCloudQueue: ((tracks: List<Track>, startIndex: Int) -> Unit)? = null,
    isFarsi: Boolean = true,
    isVipUser: Boolean = false,
    onOpenPaywall: () -> Unit = {}
) {
    val context = LocalContext.current
    val entitlementManager = remember { EntitlementManager.getInstance(context) }
    val globalVip by entitlementManager.isVip.collectAsState()
    val effectiveVip = isVipUser || globalVip
    val scope = rememberCoroutineScope()

    var searchQuery by remember { mutableStateOf("") }
    var selectedArtist by remember { mutableStateOf<String?>(null) }
    var tracks by remember { mutableStateOf<List<OnlineSongResult>>(emptyList()) }
    var artists by remember { mutableStateOf<List<OnlineArtistItem>>(emptyList()) }
    var isLoading by remember { mutableStateOf(true) }
    var errorMessage by remember { mutableStateOf<String?>(null) }

    var showPaywallSheet by remember { mutableStateOf(false) }
    var showRequestDialog by remember { mutableStateOf(false) }

    suspend fun reloadCloudCatalog() {
        isLoading = true
        errorMessage = null
        val result = CloudflareCatalogClient.fetchCatalog(context, searchQuery, selectedArtist)
        if (result.isSuccess) {
            val (fetchedTracks, fetchedArtists) = result.getOrThrow()
            tracks = fetchedTracks
            if (selectedArtist == null) {
                artists = fetchedArtists
            }
            isLoading = false
        } else {
            errorMessage = "خطا در اتصال به کلادفلر: ${result.exceptionOrNull()?.localizedMessage ?: ""}"
            isLoading = false
        }
    }

    LaunchedEffect(searchQuery, selectedArtist, effectiveVip) {
        if (searchQuery.isNotEmpty()) delay(250)
        reloadCloudCatalog()
    }

    fun handleTrackClick(index: Int, item: OnlineSongResult) {
        if (!effectiveVip) {
            showPaywallSheet = true
            return
        }
        if (onPlayCloudQueue != null && tracks.isNotEmpty()) {
            val queue = tracks.map { it.toAppTrack() }
            onPlayCloudQueue(queue, index.coerceIn(0, queue.lastIndex))
        } else {
            onPlayStream(item.streamUrl, item.title, item.artist, item.coverUrl, item.durationSec)
        }
    }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(Color(0xFF090B10))
            .padding(horizontal = 16.dp, vertical = 10.dp)
    ) {
        Row(
            modifier = Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.SpaceBetween,
            verticalAlignment = Alignment.CenterVertically
        ) {
            Surface(
                shape = RoundedCornerShape(50),
                color = if (effectiveVip) Color(0xFF1E3A2F) else Color(0xFF27203A),
                modifier = Modifier.clickable {
                    if (!effectiveVip) showPaywallSheet = true
                }
            ) {
                Row(
                    modifier = Modifier.padding(horizontal = 12.dp, vertical = 6.dp),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Icon(
                        imageVector = if (effectiveVip) Icons.Default.CheckCircle else Icons.Default.Lock,
                        contentDescription = null,
                        tint = if (effectiveVip) Color(0xFF4ADE80) else Color(0xFFFFD54F),
                        modifier = Modifier.size(16.dp)
                    )
                    Spacer(modifier = Modifier.width(6.dp))
                    Text(
                        text = if (effectiveVip) "💎 اشتراک VIP فعال (${tracks.size} آهنگ در سرور)"
                        else "👤 کاربر عادی (کد تخفیف / خرید VIP)",
                        color = Color.White,
                        fontSize = 12.sp,
                        fontWeight = FontWeight.Bold
                    )
                }
            }

            Row(verticalAlignment = Alignment.CenterVertically) {
                IconButton(onClick = { scope.launch { reloadCloudCatalog() } }) {
                    Icon(Icons.Default.Refresh, contentDescription = "Refresh", tint = Color.White)
                }
                Button(
                    onClick = {
                        if (effectiveVip) showRequestDialog = true else showPaywallSheet = true
                    },
                    shape = RoundedCornerShape(50),
                    colors = ButtonDefaults.buttonColors(containerColor = Color(0xFF7C3AED)),
                    contentPadding = PaddingValues(horizontal = 14.dp, vertical = 6.dp)
                ) {
                    Icon(Icons.Default.Add, contentDescription = null, modifier = Modifier.size(16.dp))
                    Spacer(modifier = Modifier.width(4.dp))
                    Text("درخواست آهنگ", fontSize = 12.sp, fontWeight = FontWeight.Bold)
                }
            }
        }

        Spacer(modifier = Modifier.height(10.dp))

        OutlinedTextField(
            value = searchQuery,
            onValueChange = { searchQuery = it },
            placeholder = { Text("جستجوی آهنگ یا خواننده در سرور کلادفلر...", color = Color.White.copy(alpha = 0.45f)) },
            leadingIcon = { Icon(Icons.Default.Search, contentDescription = null, tint = Color(0xFFA855F7)) },
            trailingIcon = {
                if (searchQuery.isNotEmpty() || selectedArtist != null) {
                    IconButton(onClick = {
                        searchQuery = ""
                        selectedArtist = null
                    }) {
                        Icon(Icons.Default.Close, contentDescription = "Clear", tint = Color.White)
                    }
                }
            },
            singleLine = true,
            modifier = Modifier.fillMaxWidth(),
            shape = RoundedCornerShape(16.dp),
            colors = OutlinedTextFieldDefaults.colors(
                focusedBorderColor = Color(0xFFA855F7),
                unfocusedBorderColor = Color.White.copy(alpha = 0.15f),
                focusedTextColor = Color.White,
                unfocusedTextColor = Color.White
            )
        )

        if (artists.isNotEmpty()) {
            Spacer(modifier = Modifier.height(12.dp))
            LazyRow(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
                items(artists) { artist ->
                    val isSelected = selectedArtist == artist.name
                    Column(
                        horizontalAlignment = Alignment.CenterHorizontally,
                        modifier = Modifier
                            .width(76.dp)
                            .clickable {
                                selectedArtist = if (isSelected) null else artist.name
                            }
                    ) {
                        AsyncImage(
                            model = artist.coverUrl,
                            contentDescription = artist.name,
                            contentScale = ContentScale.Crop,
                            modifier = Modifier
                                .size(62.dp)
                                .clip(CircleShape)
                                .border(
                                    width = if (isSelected) 2.5.dp else 1.dp,
                                    color = if (isSelected) Color(0xFFA855F7) else Color.White.copy(alpha = 0.2f),
                                    shape = CircleShape
                                )
                        )
                        Spacer(modifier = Modifier.height(4.dp))
                        Text(
                            text = artist.name,
                            color = if (isSelected) Color(0xFFD8B4FE) else Color.White,
                            fontSize = 11.sp,
                            maxLines = 1,
                            overflow = TextOverflow.Ellipsis,
                            fontWeight = if (isSelected) FontWeight.Bold else FontWeight.Normal
                        )
                    }
                }
            }
        }

        Spacer(modifier = Modifier.height(12.dp))

        Box(modifier = Modifier.weight(1f).fillMaxWidth()) {
            when {
                isLoading -> {
                    CircularProgressIndicator(
                        color = Color(0xFFA855F7),
                        modifier = Modifier.align(Alignment.Center)
                    )
                }
                errorMessage != null -> {
                    Column(
                        modifier = Modifier.align(Alignment.Center),
                        horizontalAlignment = Alignment.CenterHorizontally
                    ) {
                        Text(errorMessage!!, color = Color(0xFFF87171), fontSize = 14.sp)
                        Spacer(modifier = Modifier.height(8.dp))
                        Button(onClick = { scope.launch { reloadCloudCatalog() } }) {
                            Text("تلاش مجدد")
                        }
                    }
                }
                tracks.isEmpty() -> {
                    Text(
                        text = "آهنگی با این مشخصات در سرور کلادفلر پیدا نشد.",
                        color = Color.White.copy(alpha = 0.6f),
                        modifier = Modifier.align(Alignment.Center)
                    )
                }
                else -> {
                    LazyColumn(
                        verticalArrangement = Arrangement.spacedBy(10.dp),
                        contentPadding = PaddingValues(bottom = 95.dp)
                    ) {
                        itemsIndexed(tracks, key = { _, it -> it.id }) { index, track ->
                            Row(
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .clip(RoundedCornerShape(16.dp))
                                    .background(Color(0xFF141824))
                                    .clickable { handleTrackClick(index, track) }
                                    .padding(10.dp),
                                verticalAlignment = Alignment.CenterVertically
                            ) {
                                AsyncImage(
                                    model = track.coverUrl,
                                    contentDescription = track.title,
                                    contentScale = ContentScale.Crop,
                                    modifier = Modifier
                                        .size(56.dp)
                                        .clip(RoundedCornerShape(12.dp))
                                )
                                Spacer(modifier = Modifier.width(12.dp))
                                Column(modifier = Modifier.weight(1f)) {
                                    Text(
                                        text = track.title,
                                        color = Color.White,
                                        fontSize = 15.sp,
                                        fontWeight = FontWeight.Bold,
                                        maxLines = 1,
                                        overflow = TextOverflow.Ellipsis
                                    )
                                    Spacer(modifier = Modifier.height(3.dp))
                                    Text(
                                        text = "${track.artist} • ${track.album}",
                                        color = Color.White.copy(alpha = 0.65f),
                                        fontSize = 12.sp,
                                        maxLines = 1,
                                        overflow = TextOverflow.Ellipsis
                                    )
                                }
                                IconButton(onClick = { handleTrackClick(index, track) }) {
                                    Icon(
                                        imageVector = if (effectiveVip) Icons.Default.PlayArrow else Icons.Default.Lock,
                                        contentDescription = "Play",
                                        tint = if (effectiveVip) Color(0xFFA855F7) else Color(0xFFFFD54F)
                                    )
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if (showPaywallSheet) {
        VipPaywallSheet(
            entitlementManager = entitlementManager,
            onDismiss = { showPaywallSheet = false },
            onVipUnlocked = {
                showPaywallSheet = false
                scope.launch { reloadCloudCatalog() }
            },
            onStartMyketPurchase = {
                showPaywallSheet = false
                onOpenPaywall()
            }
        )
    }

    if (showRequestDialog) {
        var reqTitle by remember { mutableStateOf("") }
        var reqArtist by remember { mutableStateOf("") }
        var reqNote by remember { mutableStateOf("") }
        var reqStatus by remember { mutableStateOf<String?>(null) }
        var sendingReq by remember { mutableStateOf(false) }

        AlertDialog(
            onDismissRequest = { showRequestDialog = false },
            containerColor = Color(0xFF141824),
            title = { Text("🎵 درخواست افزودن آهنگ به کانال", color = Color.White, fontSize = 18.sp, fontWeight = FontWeight.Bold) },
            text = {
                Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {
                    OutlinedTextField(
                        value = reqTitle,
                        onValueChange = { reqTitle = it },
                        label = { Text("نام آهنگ") },
                        singleLine = true
                    )
                    OutlinedTextField(
                        value = reqArtist,
                        onValueChange = { reqArtist = it },
                        label = { Text("نام خواننده") },
                        singleLine = true
                    )
                    OutlinedTextField(
                        value = reqNote,
                        onValueChange = { reqNote = it },
                        label = { Text("یادداشت اختیاری") },
                        singleLine = true
                    )
                    if (!reqStatus.isNullOrBlank()) {
                        Text(reqStatus!!, color = Color(0xFF4ADE80), fontSize = 13.sp)
                    }
                }
            },
            confirmButton = {
                Button(
                    enabled = !sendingReq && (reqTitle.isNotBlank() || reqArtist.isNotBlank()),
                    onClick = {
                        scope.launch {
                            sendingReq = true
                            val res = entitlementManager.submitSongRequest(reqTitle, reqArtist, reqNote)
                            sendingReq = false
                            reqStatus = res.getOrNull() ?: res.exceptionOrNull()?.message
                            if (res.isSuccess) {
                                delay(1000)
                                showRequestDialog = false
                            }
                        }
                    }
                ) {
                    Text(if (sendingReq) "در حال ارسال..." else "ارسال به تلگرام")
                }
            },
            dismissButton = {
                TextButton(onClick = { showRequestDialog = false }) {
                    Text("بستن", color = Color.White.copy(alpha = 0.7f))
                }
            }
        )
    }
}

۴. فایل چهارم: SearchScreen.kt (نمایش مستقیم آهنگ‌های کلادفلر در صفحه سرچ اصلی برنامه)
📂 مسیر دقیق فایل:
app/src/main/java/com/example/ui/screens/SearchScreen.kt
(تغییرات: این فایل قبلاً توی زیپت اصلاً تغییر نکرده بود و فقط آهنگ‌های داخل گوشی را نشان می‌داد! حتماً این کد را در SearchScreen.kt جایگزین کن تا به محض باز کردن صفحه سرچ، تمام آهنگ‌های سرور alubm.parsaghorbani8861.workers.dev در بالای صفحه سرچ بیایند)
package com.example.ui.screens

import androidx.compose.foundation.background
import androidx.compose.foundation.clickable
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.lazy.LazyColumn
import androidx.compose.foundation.lazy.itemsIndexed
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.foundation.text.KeyboardActions
import androidx.compose.foundation.text.KeyboardOptions
import androidx.compose.material.icons.Icons
import androidx.compose.material.icons.filled.*
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.draw.clip
import androidx.compose.ui.focus.FocusRequester
import androidx.compose.ui.focus.focusRequester
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.layout.ContentScale
import androidx.compose.ui.platform.LocalContext
import androidx.compose.ui.platform.LocalFocusManager
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.text.input.ImeAction
import androidx.compose.ui.text.style.TextOverflow
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp
import coil.compose.AsyncImage
import com.example.CloudflareCatalogClient
import com.example.OnlineSongResult
import com.example.data.model.Track
import com.example.monetization.EntitlementManager
import com.example.toAppTrack
import com.example.ui.components.TrackArtworkThumbnail
import com.example.ui.components.VipPaywallSheet
import com.example.util.AppStrings
import kotlinx.coroutines.delay
import kotlinx.coroutines.launch

@Composable
fun SearchScreen(
    tracks: List<Track>,
    currentTrackId: Long?,
    onSearch: (String) -> Unit,
    onTrackClick: (Track, List<Track>) -> Unit,
    onTrackLongClick: (Track) -> Unit = {}
) {
    val context = LocalContext.current
    val entitlementManager = remember { EntitlementManager.getInstance(context) }
    val isVip by entitlementManager.isVip.collectAsState()
    val scope = rememberCoroutineScope()

    var query by remember { mutableStateOf("") }
    // پیش‌فرض روی 0 (نمایش همزمان سرور کلادفلر در بالا + آهنگ‌های گوشی در پایین)
    var selectedFilterTab by remember { mutableStateOf(0) }

    var cloudTracks by remember { mutableStateOf<List<OnlineSongResult>>(emptyList()) }
    var isLoadingCloud by remember { mutableStateOf(true) }
    var cloudError by remember { mutableStateOf<String?>(null) }
    var showPaywall by remember { mutableStateOf(false) }

    val focusRequester = remember { FocusRequester() }
    val focusManager = LocalFocusManager.current

    suspend fun loadCloudSongs() {
        isLoadingCloud = true
        cloudError = null
        val res = CloudflareCatalogClient.fetchCatalog(context, query, null)
        if (res.isSuccess) {
            cloudTracks = res.getOrThrow().first
        } else {
            cloudError = res.exceptionOrNull()?.localizedMessage ?: "خطا در اتصال به کلادفلر"
        }
        isLoadingCloud = false
    }

    LaunchedEffect(Unit) {
        focusRequester.requestFocus()
    }

    LaunchedEffect(query, isVip) {
        if (query.isNotEmpty()) delay(220)
        loadCloudSongs()
    }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .padding(horizontal = 16.dp, vertical = 10.dp)
    ) {
        OutlinedTextField(
            value = query,
            onValueChange = {
                query = it
                onSearch(it)
            },
            modifier = Modifier
                .fillMaxWidth()
                .focusRequester(focusRequester),
            placeholder = {
                Text(
                    "جستجو در آرشیو کلادفلر و آهنگ‌های گوشی...",
                    color = MaterialTheme.colorScheme.onSurfaceVariant
                )
            },
            leadingIcon = {
                Icon(
                    imageVector = Icons.Default.Search,
                    contentDescription = AppStrings.search,
                    tint = MaterialTheme.colorScheme.primary
                )
            },
            trailingIcon = {
                if (query.isNotEmpty()) {
                    IconButton(onClick = {
                        query = ""
                        onSearch("")
                    }) {
                        Icon(
                            imageVector = Icons.Default.Clear,
                            contentDescription = "Clear",
                            tint = MaterialTheme.colorScheme.onSurfaceVariant
                        )
                    }
                }
            },
            singleLine = true,
            shape = RoundedCornerShape(16.dp),
            colors = OutlinedTextFieldDefaults.colors(
                focusedContainerColor = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.5f),
                unfocusedContainerColor = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.3f),
                focusedBorderColor = MaterialTheme.colorScheme.primary,
                unfocusedBorderColor = Color.Transparent
            ),
            keyboardOptions = KeyboardOptions(imeAction = ImeAction.Search),
            keyboardActions = KeyboardActions(onSearch = { focusManager.clearFocus() })
        )

        Spacer(modifier = Modifier.height(10.dp))

        Row(
            modifier = Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.spacedBy(8.dp),
            verticalAlignment = Alignment.CenterVertically
        ) {
            FilterChip(
                selected = selectedFilterTab == 0,
                onClick = { selectedFilterTab = 0 },
                label = { Text("همه (${cloudTracks.size + tracks.size})", fontSize = 12.sp) }
            )
            FilterChip(
                selected = selectedFilterTab == 1,
                onClick = { selectedFilterTab = 1 },
                label = { Text("☁️ کلادفلر (${cloudTracks.size})", fontSize = 12.sp) }
            )
            FilterChip(
                selected = selectedFilterTab == 2,
                onClick = { selectedFilterTab = 2 },
                label = { Text("📱 گوشی (${tracks.size})", fontSize = 12.sp) }
            )
        }

        Spacer(modifier = Modifier.height(8.dp))

        LazyColumn(
            modifier = Modifier.fillMaxSize(),
            verticalArrangement = Arrangement.spacedBy(8.dp),
            contentPadding = PaddingValues(bottom = 100.dp)
        ) {
            // بخش اول: آهنگ‌های سرور کلادفلر (alubm.parsaghorbani8861.workers.dev)
            if (selectedFilterTab == 0 || selectedFilterTab == 1) {
                item {
                    Row(
                        modifier = Modifier
                            .fillMaxWidth()
                            .padding(vertical = 4.dp),
                        horizontalArrangement = Arrangement.SpaceBetween,
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Text(
                            text = if (isVip) "☁️ آرشیو سرور کلادفلر (💎 VIP فعال - ${cloudTracks.size} آهنگ)"
                            else "☁️ آرشیو سرور کلادفلر (نیاز به کد تخفیف / VIP)",
                            color = Color(0xFFA855F7),
                            fontSize = 13.sp,
                            fontWeight = FontWeight.Bold
                        )
                        Row(verticalAlignment = Alignment.CenterVertically) {
                            if (!isVip) {
                                TextButton(onClick = { showPaywall = true }) {
                                    Text("کد تخفیف VIP", color = Color(0xFFFFD54F), fontSize = 12.sp, fontWeight = FontWeight.Bold)
                                }
                            }
                            IconButton(onClick = { scope.launch { loadCloudSongs() } }) {
                                Icon(Icons.Default.Refresh, contentDescription = "Refresh", tint = Color(0xFFA855F7))
                            }
                        }
                    }
                }

                when {
                    isLoadingCloud -> {
                        item {
                            Box(
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .padding(16.dp),
                                contentAlignment = Alignment.Center
                            ) {
                                CircularProgressIndicator(modifier = Modifier.size(26.dp))
                            }
                        }
                    }
                    cloudError != null -> {
                        item {
                            Text(
                                text = "خطا در دریافت از کلادفلر: $cloudError",
                                color = Color(0xFFF87171),
                                fontSize = 12.sp,
                                modifier = Modifier.padding(vertical = 6.dp)
                            )
                        }
                    }
                    cloudTracks.isEmpty() -> {
                        item {
                            Text(
                                text = "آهنگی در سرور کلادفلر پیدا نشد (مطمئن شوید یک بار لینک /test سرور را باز کرده‌اید).",
                                color = MaterialTheme.colorScheme.onSurfaceVariant,
                                fontSize = 12.sp,
                                modifier = Modifier.padding(vertical = 6.dp)
                            )
                        }
                    }
                    else -> {
                        val convertedCloudQueue = cloudTracks.map { it.toAppTrack() }
                        itemsIndexed(cloudTracks, key = { _, item -> "cloud_${item.id}" }) { idx, cTrack ->
                            val appTrack = convertedCloudQueue[idx]
                            Row(
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .clip(RoundedCornerShape(14.dp))
                                    .background(Color(0xFF141824))
                                    .clickable {
                                        if (!isVip) {
                                            showPaywall = true
                                        } else {
                                            onTrackClick(appTrack, convertedCloudQueue)
                                        }
                                    }
                                    .padding(10.dp),
                                verticalAlignment = Alignment.CenterVertically
                            ) {
                                AsyncImage(
                                    model = cTrack.coverUrl,
                                    contentDescription = cTrack.title,
                                    contentScale = ContentScale.Crop,
                                    modifier = Modifier
                                        .size(52.dp)
                                        .clip(RoundedCornerShape(10.dp))
                                )
                                Spacer(modifier = Modifier.width(12.dp))
                                Column(modifier = Modifier.weight(1f)) {
                                    Text(
                                        text = cTrack.title,
                                        color = Color.White,
                                        fontSize = 15.sp,
                                        fontWeight = FontWeight.Bold,
                                        maxLines = 1,
                                        overflow = TextOverflow.Ellipsis
                                    )
                                    Text(
                                        text = "☁️ ${cTrack.artist} • ${cTrack.album}",
                                        color = Color.White.copy(alpha = 0.65f),
                                        fontSize = 12.sp,
                                        maxLines = 1,
                                        overflow = TextOverflow.Ellipsis
                                    )
                                }
                                Icon(
                                    imageVector = if (isVip) Icons.Default.PlayArrow else Icons.Default.Lock,
                                    contentDescription = null,
                                    tint = if (isVip) Color(0xFFA855F7) else Color(0xFFFFD54F)
                                )
                            }
                        }
                    }
                }
            }

            // بخش دوم: آهنگ‌های داخل گوشی
            if (selectedFilterTab == 0 || selectedFilterTab == 2) {
                item {
                    Spacer(modifier = Modifier.height(8.dp))
                    Text(
                        text = "📱 آهنگ‌های داخل گوشی (${tracks.size})",
                        color = MaterialTheme.colorScheme.primary,
                        fontSize = 13.sp,
                        fontWeight = FontWeight.Bold,
                        modifier = Modifier.padding(vertical = 4.dp)
                    )
                }

                itemsIndexed(tracks, key = { _, t -> "local_${t.id}" }) { _, track ->
                    Row(
                        modifier = Modifier
                            .fillMaxWidth()
                            .clip(RoundedCornerShape(12.dp))
                            .clickable { onTrackClick(track, tracks) }
                            .padding(vertical = 8.dp, horizontal = 8.dp),
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        TrackArtworkThumbnail(
                            trackId = track.id,
                            albumArtUri = track.albumArtUri,
                            title = track.title,
                            artist = track.artist,
                            size = 50.dp,
                            cornerRadius = 8.dp
                        )
                        Spacer(modifier = Modifier.width(16.dp))
                        Column(modifier = Modifier.weight(1f)) {
                            Text(
                                text = track.title,
                                style = MaterialTheme.typography.bodyLarge,
                                fontWeight = if (track.id == currentTrackId) FontWeight.Bold else FontWeight.Medium,
                                color = if (track.id == currentTrackId) MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.onSurface,
                                maxLines = 1,
                                overflow = TextOverflow.Ellipsis
                            )
                            Text(
                                text = "${track.artist} • ${track.album}",
                                style = MaterialTheme.typography.bodyMedium,
                                color = MaterialTheme.colorScheme.onSurfaceVariant,
                                maxLines = 1,
                                overflow = TextOverflow.Ellipsis
                            )
                        }
                        IconButton(onClick = { onTrackLongClick(track) }) {
                            Icon(
                                imageVector = Icons.Default.MoreVert,
                                contentDescription = AppStrings.moreOptions,
                                tint = MaterialTheme.colorScheme.onSurfaceVariant
                            )
                        }
                    }
                }
            }
        }
    }

    if (showPaywall) {
        VipPaywallSheet(
            entitlementManager = entitlementManager,
            onDismiss = { showPaywall = false },
            onVipUnlocked = {
                showPaywall = false
                scope.launch { loadCloudSongs() }
            }
        )
    }
}

