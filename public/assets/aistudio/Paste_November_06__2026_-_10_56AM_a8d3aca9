    suspend fun fetchRemoteConfigSync(): VipRemoteConfig = withContext(Dispatchers.IO) {
        val deviceId = getHardwareDeviceId()
        val localVipNow = verifyLocalHardwareBoundVip() || legacyPrefs.getBoolean("is_vip_lifetime", false)
        if (localVipNow) {
            markVipUnlockedInMemory()
        }

        try {
            val url = URL("${CLOUDFLARE_WORKER_URL.trimEnd('/')}/vip-config?deviceId=$deviceId")
            val conn = (url.openConnection() as HttpURLConnection).apply {
                requestMethod = "GET"
                connectTimeout = 8000
                readTimeout = 8000
                setRequestProperty("X-Device-Id", deviceId)
            }
            if (conn.responseCode in 200..299) {
                val body = conn.inputStream.bufferedReader().use { it.readText() }
                val json = JSONObject(body)
                val serverVip = json.optBoolean("isVip", false) || json.optBoolean("vip", false)

                if (serverVip && !localVipNow) {
                    saveLocalHardwareBoundVip("SERVER_RESTORED_$deviceId")
                } else if (!serverVip && localVipNow) {
                    val savedToken = prefs.getString(KEY_VIP_TOKEN, null) ?: "PROMO_VIP_SYNC_$deviceId"
                    syncLocalVipToServer(deviceId, savedToken)
                }

                val finalVip = _globalIsVip.value || localVipNow || serverVip
                if (finalVip) markVipUnlockedInMemory()

                val cfg = VipRemoteConfig(
                    salesOpen = json.optBoolean("salesOpen", true),
                    sku = json.optString("sku", MYKET_SKU),
                    productTitle = json.optString("productTitle", "اشتراک پریمیوم"),
                    originalPriceToman = json.optInt("originalPrice", 275000),
                    discountPriceToman = json.optInt("discountPrice", 75000),
                    priceRials = json.optInt("priceRials", 750000),
                    bannerText = json.optString("bannerText", _globalVipConfig.value.bannerText),
                    totalCapacity = json.optInt("totalCapacity", 50),
                    soldCount = json.optInt("soldCount", 0),
                    remainingCapacity = json.optInt("remainingCapacity", 50),
                    isVip = finalVip
                )
                _globalVipConfig.value = cfg
                return@withContext cfg
            }
        } catch (e: Exception) {
            e.printStackTrace()
        }
        return@withContext _globalVipConfig.value.copy(isVip = _globalIsVip.value || localVipNow)
    }

