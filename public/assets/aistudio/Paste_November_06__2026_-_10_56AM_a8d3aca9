@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun VipPaywallSheet(
    entitlementManager: EntitlementManager? = null,
    highlightedFeature: FeatureGate? = null,
    isFarsi: Boolean = true,
    onDismiss: () -> Unit,
    onUnlocked: () -> Unit = {},
    onVipUnlocked: () -> Unit = {},
    onStartMyketPurchase: ((String) -> Unit)? = null
