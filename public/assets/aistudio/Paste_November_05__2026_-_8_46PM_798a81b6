/**
 * صفحه کاملاً بازطراحی‌شده کلادفلر / آرشیو تلگرام با فضای Spotify & Apple Music
 * هیچ لیست هزارتایی و طولانی‌ای در صفحه اصلی وجود ندارد!
 */
@Composable
fun OnlineMusicScreen(
    onlineTracks: List<Track>,
    isLoading: Boolean = false,
    currentPlayingTrack: Track? = null,
    onPlayTrack: (Track, List<Track>) -> Unit,
    onRefresh: () -> Unit = {}
) {
    var searchQuery by remember { mutableStateOf("") }
    var activeTab by remember { mutableStateOf(TopHubTab.DISCOVER) }
    var navState by remember { mutableStateOf<HubNavigationState>(HubNavigationState.MainHub) }
    var quickPicksSeed by remember { mutableIntStateOf(0) }

    BackHandler(enabled = navState != HubNavigationState.MainHub || searchQuery.isNotBlank()) {
        if (navState != HubNavigationState.MainHub) {
            navState = HubNavigationState.MainHub
        } else {
            searchQuery = ""
        }
    }

    // ۱. گروه‌بندی هوشمند آلبوم‌ها (حتی اگر تگ آلبوم در تلگرام ناقص باشد، بر اساس خواننده مجموعه می‌سازد تا پخش‌وپلا نباشند)
    val albums = remember(onlineTracks) {
        onlineTracks
            .groupBy { track ->
                val cleanArtist = track.artist.trim().ifBlank { "آرتیست‌های مختلف" }
                val cleanAlbum = track.album.trim().let {
                    if (it.isBlank() || it.equals("unknown", true) || it.equals("Telegram", true)) {
                        "مجموعه آثار $cleanArtist"
                    } else it
                }
                "${cleanArtist}__$cleanAlbum"
            }
            .map { (key, list) ->
                val first = list.first()
                val cleanArtist = first.artist.trim().ifBlank { "آرتیست‌های مختلف" }
                val cleanTitle = first.album.trim().let {
                    if (it.isBlank() || it.equals("unknown", true) || it.equals("Telegram", true)) {
                        "کلکسیون $cleanArtist"
                    } else it
                }
                CloudAlbumCollection(
                    id = key,
                    title = cleanTitle,
                    artist = cleanArtist,
                    coverUri = list.firstOrNull { !it.artworkUri.isNullOrBlank() }?.artworkUri,
                    tracks = list
                )
            }
            .sortedByDescending { it.tracks.size }
    }

    // ۲. استخراج پروفایل هنرمندان
    val artists = remember(onlineTracks, albums) {
        onlineTracks
            .groupBy { it.artist.trim().ifBlank { "خواننده ناشناس" } }
            .map { (artistName, list) ->
                CloudArtistProfile(
                    name = artistName,
                    tracks = list,
                    albums = albums.filter { it.artist.equals(artistName, ignoreCase = true) }
                )
            }
            .sortedByDescending { it.tracks.size }
    }

    // ۳. ساخت ۱۲ پیشنهاد سریع (۳ ردیف افقی مثل Apple Music) با قابلیت تعویض تصادفی
    val quickPicks = remember(onlineTracks, quickPicksSeed) {
        if (onlineTracks.isEmpty()) emptyList()
        else onlineTracks.shuffled().take(15)
    }

    // ۴. دسته‌بندی‌های رنگی به سبک تب Browse اسپاتیفای
    val browseCategories = remember(onlineTracks) {
        listOf(
            SpotifyBrowseCategory(
                id = "trending",
                title = "داغ‌ترین‌های تلگرام",
                subtitle = "برترین‌های آرشیو کلادفلر",
                icon = Icons.Default.LocalFireDepartment,
                gradient = listOf(Color(0xFFE1306C), Color(0xFF4A0E2E)),
                filterPredicate = { abs(it.id.hashCode()) % 3 == 0 }
            ),
            SpotifyBrowseCategory(
                id = "persian_pop",
                title = "پاپ و عاشقانه",
                subtitle = "بهترین‌های پاپ فارسی",
                icon = Icons.Default.Favorite,
                gradient = listOf(Color(0xFF1DB954), Color(0xFF093819)),
                filterPredicate = {
                    it.title.any { ch -> ch in '\u0600'..'\u06FF' } ||
                        it.artist.any { ch -> ch in '\u0600'..'\u06FF' }
                }
            ),
            SpotifyBrowseCategory(
                id = "rap_hiphop",
                title = "رپ و هیپ‌هاپ",
                subtitle = "بیت‌های سنگین و رپ",
                icon = Icons.Default.GraphicEq,
                gradient = listOf(Color(0xFF8338EC), Color(0xFF240046)),
                filterPredicate = {
                    val text = "${it.title} ${it.artist} ${it.album}".lowercase()
                    text.contains("rap") || text.contains("رپ") || text.contains("feat") || text.contains("دیس") || abs(it.title.hashCode()) % 4 == 1
                }
            ),
            SpotifyBrowseCategory(
                id = "remix_party",
                title = "ریمیکس و انرژی",
                subtitle = "مخصوص رانندگی و مهمانی",
                icon = Icons.Default.Bolt,
                gradient = listOf(Color(0xFFFF9F1C), Color(0xFF5C2D05)),
                filterPredicate = {
                    val text = "${it.title} ${it.artist}".lowercase()
                    text.contains("remix") || text.contains("ریمیکس") || text.contains("dj") || text.contains("club") || abs(it.title.hashCode()) % 5 == 0
                }
            ),
            SpotifyBrowseCategory(
                id = "chill_night",
                title = "شبانه و لوفای",
                subtitle = "آرامش‌بخش و عمیق",
                icon = Icons.Default.NightsStay,
                gradient = listOf(Color(0xFF00B4D8), Color(0xFF03045E)),
                filterPredicate = { abs(it.title.hashCode()) % 4 == 2 }
            ),
            SpotifyBrowseCategory(
                id = "international",
                title = "موزیک خارجی",
                subtitle = "Global & English Hits",
                icon = Icons.Default.Public,
                gradient = listOf(Color(0xFF3A86FF), Color(0xFF0B132B)),
                filterPredicate = {
                    it.title.none { ch -> ch in '\u0600'..'\u06FF' } &&
                        it.artist.none { ch -> ch in '\u0600'..'\u06FF' }
                }
            ),
            SpotifyBrowseCategory(
                id = "nostalgia",
                title = "نوستالژی و خاطره",
                subtitle = "آهنگ‌های ماندگار",
                icon = Icons.Default.History,
                gradient = listOf(Color(0xFFEC4899), Color(0xFF500724)),
                filterPredicate = { abs(it.artist.hashCode()) % 3 == 1 }
            ),
            SpotifyBrowseCategory(
                id = "lucky_mix",
                title = "شانس امروز تو",
                subtitle = "۵۰ آهنگ تصادفی آرشیو",
                icon = Icons.Default.Casino,
                gradient = listOf(Color(0xFF10B981), Color(0xFF064E3B)),
                filterPredicate = { true }
            )
        )
    }

    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(
                Brush.verticalGradient(
                    listOf(Color(0xFF10141E), Color(0xFF07090E), Color(0xFF050608))
                )
            )
    ) {
        AnimatedContent(
            targetState = navState,
            label = "SpotifyHubNav"
        ) { state ->
            when (state) {
                is HubNavigationState.ArtistPage -> {
                    SpotifyFullArtistScreen(
                        artist = state.artist,
                        currentPlayingTrack = currentPlayingTrack,
                        onBack = { navState = HubNavigationState.MainHub },
                        onAlbumClick = { navState = HubNavigationState.AlbumPage(it) },
                        onPlayTrack = onPlayTrack
                    )
                }

                is HubNavigationState.AlbumPage -> {
                    SpotifyFullAlbumScreen(
                        album = state.album,
                        currentPlayingTrack = currentPlayingTrack,
                        onBack = { navState = HubNavigationState.MainHub },
                        onPlayTrack = onPlayTrack
                    )
                }

                is HubNavigationState.CategoryPage -> {
                    SpotifyCategoryPlaylistScreen(
                        category = state.category,
                        tracks = state.tracks,
                        currentPlayingTrack = currentPlayingTrack,
                        onBack = { navState = HubNavigationState.MainHub },
                        onPlayTrack = onPlayTrack
                    )
                }

                HubNavigationState.MainHub -> {
                    LazyColumn(
                        modifier = Modifier.fillMaxSize(),
                        contentPadding = PaddingValues(bottom = 130.dp)
                    ) {
                        // هدر نئونی و باکس جستجوی مدرن
                        item {
                            SpotifyGlassTopBar(
                                totalTracks = onlineTracks.size,
                                totalArtists = artists.size,
                                searchQuery = searchQuery,
                                onSearchChange = { searchQuery = it },
                                onRefresh = onRefresh
                            )
                        }

                        // اگر کاربر در حال تایپ در سرچ است -> فقط نتایج دسته‌بندی‌شده و تمیز را نشان بده
                        if (searchQuery.isNotBlank()) {
                            item {
                                CategorizedInstantSearchResults(
                                    query = searchQuery,
                                    artists = artists,
                                    albums = albums,
                                    allTracks = onlineTracks,
                                    currentPlayingTrack = currentPlayingTrack,
                                    onArtistClick = { navState = HubNavigationState.ArtistPage(it) },
                                    onAlbumClick = { navState = HubNavigationState.AlbumPage(it) },
                                    onPlayTrack = onPlayTrack
                                )
                            }
                        } else {
                            // تب‌های ناوبری بالای صفحه (ویترین | دسته‌بندی‌ها | هنرمندان | فول‌آلبوم‌ها)
                            item {
                                LazyRow(
                                    contentPadding = PaddingValues(horizontal = 16.dp, vertical = 10.dp),
                                    horizontalArrangement = Arrangement.spacedBy(10.dp)
                                ) {
                                    items(TopHubTab.entries) { tab ->
                                        val isSelected = activeTab == tab
                                        Surface(
                                            onClick = { activeTab = tab },
                                            shape = RoundedCornerShape(50),
                                            color = if (isSelected) Color(0xFF1DB954) else Color.White.copy(alpha = 0.07f),
                                            border = if (isSelected) null else androidx.compose.foundation.BorderStroke(
                                                1.dp,
                                                Color.White.copy(alpha = 0.12f)
                                            )
                                        ) {
                                            Row(
