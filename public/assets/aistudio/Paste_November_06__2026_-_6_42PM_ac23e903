                focusedContainerColor = Color.White.copy(alpha = 0.07f),
                unfocusedContainerColor = Color.White.copy(alpha = 0.04f),
                focusedBorderColor = Color(0xFFA855F7),
                unfocusedBorderColor = Color.White.copy(alpha = 0.12f),
                focusedTextColor = Color.White,
                unfocusedTextColor = Color.White
            )
        )

        // لیست افقی خواننده‌ها با عکس‌های دایره‌ای (سبک Spotify)
        if (artists.isNotEmpty()) {
            Spacer(modifier = Modifier.height(14.dp))
            LazyRow(horizontalArrangement = Arrangement.spacedBy(14.dp)) {
                items(artists) { artist ->
                    val isSelected = selectedArtist == artist.name
                    Column(
                        horizontalAlignment = Alignment.CenterHorizontally,
                        modifier = Modifier
                            .width(76.dp)
                            .clickable {
                                selectedArtist = if (isSelected) null else artist.name
                            }
                    ) {
                        AsyncImage(
                            model = artist.coverUrl,
                            contentDescription = artist.name,
                            contentScale = ContentScale.Crop,
                            modifier = Modifier
                                .size(64.dp)
                                .clip(CircleShape)
                                .border(
                                    width = if (isSelected) 2.5.dp else 1.dp,
                                    color = if (isSelected) Color(0xFFA855F7) else Color.White.copy(alpha = 0.2f),
                                    shape = CircleShape
                                )
                        )
                        Spacer(modifier = Modifier.height(5.dp))
                        Text(
                            text = artist.name,
                            color = if (isSelected) Color(0xFFD8B4FE) else Color.White,
                            fontSize = 11.sp,
                            maxLines = 1,
                            overflow = TextOverflow.Ellipsis,
                            fontWeight = if (isSelected) FontWeight.Bold else FontWeight.Medium
                        )
                    }
                }
            }
        }

        Spacer(modifier = Modifier.height(12.dp))

        // لیست عمودی آهنگ‌ها با المان‌های شیشه‌ای (Liquid Glass)
        Box(modifier = Modifier.weight(1f).fillMaxWidth()) {
            when {
                isLoading -> {
                    CircularProgressIndicator(
                        color = Color(0xFFA855F7),
                        modifier = Modifier.align(Alignment.Center)
                    )
                }
                errorMessage != null -> {
                    Column(
                        modifier = Modifier.align(Alignment.Center),
                        horizontalAlignment = Alignment.CenterHorizontally
                    ) {
                        Text(errorMessage!!, color = Color(0xFFF87171), fontSize = 14.sp)
                        Spacer(modifier = Modifier.height(8.dp))
                        Button(onClick = { scope.launch { reloadCloudCatalog() } }) {
                            Text("تلاش مجدد")
                        }
                    }
                }
                tracks.isEmpty() -> {
                    Text(
                        text = "آهنگی با این مشخصات در آرشیو پیدا نشد.",
                        color = Color.White.copy(alpha = 0.6f),
                        modifier = Modifier.align(Alignment.Center)
                    )
                }
                else -> {
                    LazyColumn(
                        verticalArrangement = Arrangement.spacedBy(10.dp),
                        contentPadding = PaddingValues(bottom = 95.dp)
                    ) {
                        itemsIndexed(tracks, key = { _, it -> it.id }) { index, track ->
                            Row(
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .clip(RoundedCornerShape(18.dp))
                                    .background(Color.White.copy(alpha = 0.05f))
                                    .border(1.dp, Color.White.copy(alpha = 0.09f), RoundedCornerShape(18.dp))
                                    .clickable { handleTrackPlay(index, track) }
                                    .padding(10.dp),
                                verticalAlignment = Alignment.CenterVertically
                            ) {
                                AsyncImage(
                                    model = track.coverUrl,
                                    contentDescription = track.title,
                                    contentScale = ContentScale.Crop,
                                    modifier = Modifier
                                        .size(56.dp)
                                        .clip(RoundedCornerShape(12.dp))
                                )
                                Spacer(modifier = Modifier.width(12.dp))
                                Column(modifier = Modifier.weight(1f)) {
                                    Text(
                                        text = track.title,
                                        color = Color.White,
                                        fontSize = 15.sp,
                                        fontWeight = FontWeight.Bold,
                                        maxLines = 1,
                                        overflow = TextOverflow.Ellipsis
                                    )
                                    Spacer(modifier = Modifier.height(3.dp))
                                    Text(
                                        text = "${track.artist} • ${track.album}",
                                        color = Color.White.copy(alpha = 0.65f),
                                        fontSize = 12.sp,
                                        maxLines = 1,
                                        overflow = TextOverflow.Ellipsis
                                    )
                                }
                                IconButton(onClick = { handleTrackDownload(track) }) {
                                    Icon(
                                        imageVector = Icons.Default.KeyboardArrowDown,
                                        contentDescription = "Download",
                                        tint = Color.White.copy(alpha = 0.75f)
                                    )
                                }
                                IconButton(onClick = { handleTrackPlay(index, track) }) {
                                    Icon(
                                        imageVector = Icons.Default.PlayArrow,
                                        contentDescription = "Play",
                                        tint = Color(0xFFA855F7)
                                    )
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if (showPaywallSheet) {
        VipPaywallSheet(
            entitlementManager = entitlementManager,
            onDismiss = { showPaywallSheet = false },
            onVipUnlocked = { showPaywallSheet = false },
            onStartMyketPurchase = {
                showPaywallSheet = false
                onOpenPaywall()
            }
        )
    }

    // دیالوگ درخواست آهنگ (مخصوص کاربران VIP - ۳ عدد در روز)
    if (showRequestDialog) {
        var reqTitle by remember { mutableStateOf("") }
        var reqArtist by remember { mutableStateOf("") }
        var reqNote by remember { mutableStateOf("") }
        var reqStatus by remember { mutableStateOf<String?>(null) }
        var isReqError by remember { mutableStateOf(false) }
        var sendingReq by remember { mutableStateOf(false) }

        AlertDialog(
            onDismissRequest = { showRequestDialog = false },
            containerColor = Color(0xFF121624),
            title = {
                Text(
                    "👑 درخواست آهنگ VIP (۳ سهمیه روزانه)",
                    color = Color.White,
                    fontSize = 17.sp,
                    fontWeight = FontWeight.Bold
                )
            },
            text = {
                Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {
                    OutlinedTextField(
                        value = reqTitle,
                        onValueChange = { reqTitle = it },
                        label = { Text("نام آهنگ") },
                        singleLine = true
                    )
                    OutlinedTextField(
                        value = reqArtist,
                        onValueChange = { reqArtist = it },
                        label = { Text("نام خواننده") },
                        singleLine = true
                    )
                    OutlinedTextField(
                        value = reqNote,
                        onValueChange = { reqNote = it },
                        label = { Text("یادداشت اختیاری") },
                        singleLine = true
                    )
                    if (!reqStatus.isNullOrBlank()) {
                        Text(
                            text = reqStatus!!,
                            color = if (isReqError) Color(0xFFF87171) else Color(0xFF4ADE80),
                            fontSize = 13.sp
                        )
                    }
                }
            },
            confirmButton = {
                Button(
                    enabled = !sendingReq && (reqTitle.isNotBlank() || reqArtist.isNotBlank()),
                    onClick = {
                        scope.launch {
                            sendingReq = true
                            val res = entitlementManager.submitSongRequest(reqTitle, reqArtist, reqNote)
                            sendingReq = false
                            isReqError = res.isFailure
                            reqStatus = res.getOrNull() ?: res.exceptionOrNull()?.message
                            if (res.isSuccess) {
                                delay(1000)
                                showRequestDialog = false
                            }
                        }
                    }
                ) {
                    Text(if (sendingReq) "در حال ارسال..." else "ارسال به کانال")
                }
            },
            dismissButton = {
                TextButton(onClick = { showRequestDialog = false }) {
                    Text("بستن", color = Color.White.copy(alpha = 0.7f))
                }
            }
        )
    }
}

