                            )
                        }

                        if (connectedDevice != null) {
                            AudioDeviceIndicator(
                                device = connectedDevice,
                                compact = false
                            )
                        } else {
                            Box(
                                modifier = Modifier
                                    .liquidGlass(
                                        shape = RoundedCornerShape(28.dp),
                                        thickness = GlassThickness.THIN,
                                        tintColor = coverPrimary,
