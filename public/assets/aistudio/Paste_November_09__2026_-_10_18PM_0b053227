enum class NowPlayingCenterView {
    ARTWORK_AND_HALO,
    LYRICS
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun NowPlayingScreen(
    playbackState: PlaybackState,
    palette: AmbientPalette,
    currentLyrics: List<LyricsLine>,
    appSettings: AppSettings,
    onCollapse: () -> Unit,
    onTogglePlay: () -> Unit,
    onNext: () -> Unit,
    onPrevious: () -> Unit,
    onSeekTo: (Long) -> Unit,
    onToggleFavorite: (Track) -> Unit,
    onToggleShuffle: () -> Unit,
    onCycleRepeat: () -> Unit,
    onOpenLyricsEditor: () -> Unit,
    onOpenEqualizer: () -> Unit,
    onOpenQueue: () -> Unit,
    onSelectVisualizerMode: (VisualizerMode) -> Unit,
    onOpenSleepTimer: () -> Unit,
    onOpenMetadataEditor: (Track) -> Unit,
    modifier: Modifier = Modifier,
    connectedDevice: ConnectedAudioDevice? = null,
    onShareSong: (Track) -> Unit = {},
    onPlaybackSpeedChange: (Float) -> Unit = {},
    audioProfile: TrackAudioProfile? = null,
    onCycleShuffleMode: () -> Unit = onToggleShuffle,
    onOpenHearingCalibration: () -> Unit = {},
    onOpenVipPaywall: (String?) -> Unit = {},
    onSelectNowPlayingStyle: (String) -> Unit = {},
    onUpdateTrackArtwork: (Track, String?) -> Unit = { _, _ -> },
    analysisDataProvider: () -> AudioAnalysisData = { AudioAnalysisData() },
    currentPositionProvider: () -> Long = { playbackState.currentPositionMs },
    loopStartMs: Long? = null,
    loopEndMs: Long? = null,
    onSetAbLoop: (Long?, Long?) -> Unit = { _, _ -> },
    onClearAbLoop: () -> Unit = {},
    onDownloadTrack: (Track) -> Unit = {}
) {
    val context = LocalContext.current
    val track = playbackState.currentTrack ?: return
    val isFa = appSettings.language == AppLanguage.PERSIAN

    val downloadingIds by OnlineCacheHolder.downloadingTrackIds.collectAsState()
    val downloadedIds by OnlineCacheHolder.downloadedTrackIds.collectAsState()
    val downloadProgressMap by OnlineCacheHolder.downloadProgressMap.collectAsState()

    val isOnlineTrack = track.id.startsWith("online_") || track.uri.startsWith("http")
    val isDownloadedToPhone = downloadedIds.contains(track.id) ||
        downloadedIds.contains(track.id.removePrefix("online_")) ||
        OnlineCacheHolder.isTrackCached(context, track.id) ||
        (!isOnlineTrack && !track.uri.startsWith("http"))
    val isDownloadingNow = downloadingIds.contains(track.id) ||
        downloadingIds.contains(track.id.removePrefix("online_"))
    val currentDownloadProgress = downloadProgressMap[track.id]
        ?: downloadProgressMap[track.id.removePrefix("online_")]
        ?: 0

    var centerView by remember { mutableStateOf(NowPlayingCenterView.ARTWORK_AND_HALO) }
    var isImmersive by remember { mutableStateOf(false) }
    var showMoreMenu by remember { mutableStateOf(false) }
    var showRadialMenu by remember { mutableStateOf(false) }
    val haptic = LocalHapticFeedback.current

    val triggerHaptic = {
        if (appSettings.hapticFeedbackEnabled) {
            try {
                haptic.performHapticFeedback(HapticFeedbackType.TextHandleMove)
            } catch (_: Exception) {}
        }
    }

    val isPlaying = playbackState.isPlaying

    val coverPrimary by animateColorAsState(
        targetValue = palette.primary,
        animationSpec = tween(550, easing = FastOutSlowInEasing),
        label = "coverPrimary"
    )
    val coverSecondary by animateColorAsState(
        targetValue = palette.secondary,
        animationSpec = tween(550, easing = FastOutSlowInEasing),
        label = "coverSecondary"
    )
    val coverAccent by animateColorAsState(
        targetValue = palette.accent,
        animationSpec = tween(550, easing = FastOutSlowInEasing),
        label = "coverAccent"
    )

    val dynamicCoverPalette = remember(coverPrimary, coverSecondary, coverAccent, palette) {
        palette.copy(
            primary = coverPrimary,
            secondary = coverSecondary,
            accent = coverAccent,
            haloGlow = coverPrimary.copy(alpha = 0.5f)
        )
    }

    val photoPickerLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.PickVisualMedia()
    ) { uri: Uri? ->
        if (uri != null) {
            try {
                context.contentResolver.takePersistableUriPermission(
                    uri,
                    android.content.Intent.FLAG_GRANT_READ_URI_PERMISSION
                )
            } catch (_: Exception) {}
            onUpdateTrackArtwork(track, uri.toString())
        }
    }

    val waveformFloats = remember(audioProfile?.waveformEnvelope) {
        audioProfile?.waveformEnvelope
            ?.split(",")
            ?.mapNotNull { it.trim().toFloatOrNull() }
            ?.toFloatArray()
    }

    val artworkScale by animateFloatAsState(
        targetValue = if (isPlaying) 1.0f else 0.94f,
        animationSpec = tween(durationMillis = 300, easing = FastOutSlowInEasing),
        label = "artworkScale"
    )

    Box(
        modifier = modifier
            .fillMaxSize()
            .testTag("now_playing_screen")
    ) {
        // Clean Spotify-style vertical gradient background derived from album artwork
        CinematicAtmosphereBackground(
            track = track,
            palette = dynamicCoverPalette,
            analysisDataProvider = analysisDataProvider,
            glowStrength = if (isImmersive) 1.0f else 0.85f
        )

        Column(
            modifier = Modifier
                .fillMaxSize()
                .statusBarsPadding()
                .navigationBarsPadding()
                .padding(horizontal = 24.dp, vertical = 12.dp),
            horizontalAlignment = Alignment.CenterHorizontally,
            verticalArrangement = Arrangement.SpaceBetween
        ) {
            // 1. Top Bar (Spotify Header: Collapse Chevron, Playing Context / Mode Toggle, More Menu)
            AnimatedVisibility(
                visible = !isImmersive,
                enter = fadeIn() + expandVertically(),
                exit = fadeOut() + shrinkVertically()
            ) {
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    IconButton(
                        onClick = {
                            triggerHaptic()
                            onCollapse()
                        },
                        modifier = Modifier
                            .size(40.dp)
                            .testTag("collapse_now_playing_button")
                    ) {
                        Icon(
                            imageVector = Icons.Default.KeyboardArrowDown,
                            contentDescription = "Collapse",
                            tint = Color.White,
                            modifier = Modifier.size(30.dp)
                        )
                    }

                    Column(
                        horizontalAlignment = Alignment.CenterHorizontally,
                        modifier = Modifier
                            .weight(1f)
                            .padding(horizontal = 8.dp)
                            .clickable {
                                triggerHaptic()
                                centerView = if (centerView == NowPlayingCenterView.ARTWORK_AND_HALO) {
                                    NowPlayingCenterView.LYRICS
                                } else {
                                    NowPlayingCenterView.ARTWORK_AND_HALO
                                }
                            }
                    ) {
                        Text(
                            text = if (isFa) "در حال پخش از" else "PLAYING FROM ALBUM",
                            style = MaterialTheme.typography.labelSmall.copy(
                                color = Color.White.copy(alpha = 0.7f),
                                fontWeight = FontWeight.Medium,
                                letterSpacing = 1.sp,
                                fontSize = 10.sp
                            ),
                            maxLines = 1,
                            overflow = TextOverflow.Ellipsis
                        )
                        Spacer(modifier = Modifier.height(2.dp))
                        Text(
                            text = track.album.ifBlank { track.artist },
                            style = MaterialTheme.typography.labelLarge.copy(
                                color = Color.White,
                                fontWeight = FontWeight.Bold,
                                fontSize = 13.sp
                            ),
                            maxLines = 1,
                            overflow = TextOverflow.Ellipsis,
                            textAlign = TextAlign.Center
                        )
                    }

                    Box {
                        IconButton(
                            onClick = { showMoreMenu = true },
                            modifier = Modifier.size(40.dp)
                        ) {
                            Icon(
                                imageVector = Icons.Default.MoreVert,
                                contentDescription = "Options",
                                tint = Color.White,
                                modifier = Modifier.size(24.dp)
                            )
                        }

                        DropdownMenu(
                            expanded = showMoreMenu,
                            onDismissRequest = { showMoreMenu = false },
                            modifier = Modifier.background(AuraSurfaceElevated)
                        ) {
                            DropdownMenuItem(
                                text = {
                                    Text(
                                        if (isFa) "تغییر کاور آهنگ" else "Change Song Artwork",
                                        color = Color.White
                                    )
                                },
                                leadingIcon = {
                                    Icon(
                                        Icons.Default.AddPhotoAlternate,
                                        contentDescription = null,
                                        tint = Color.White
                                    )
                                },
                                onClick = {
                                    showMoreMenu = false
                                    photoPickerLauncher.launch(
                                        PickVisualMediaRequest(ActivityResultContracts.PickVisualMedia.ImageOnly)
                                    )
                                }
                            )
                            DropdownMenuItem(
                                text = {
                                    Text(
                                        if (isFa) "اکولایزر و تنظیمات صدا" else "Equalizer & DSP",
                                        color = Color.White
                                    )
                                },
                                leadingIcon = {
                                    Icon(
                                        Icons.Default.Tune,
                                        contentDescription = null,
                                        tint = Color.White
                                    )
                                },
                                onClick = {
                                    showMoreMenu = false
                                    onOpenEqualizer()
                                }
                            )
                            DropdownMenuItem(
                                text = {
                                    Text(
                                        if (isFa) "تایمر خواب" else "Sleep Timer",
                                        color = Color.White
                                    )
                                },
                                leadingIcon = {
                                    Icon(
                                        Icons.Default.Snooze,
                                        contentDescription = null,
                                        tint = Color.White
                                    )
                                },
                                onClick = {
                                    showMoreMenu = false
                                    onOpenSleepTimer()
                                }
                            )
                            DropdownMenuItem(
                                text = {
                                    Text(
                                        if (isFa) "ویرایش اطلاعات آهنگ" else "Edit Metadata",
                                        color = Color.White
                                    )
                                },
                                leadingIcon = {
                                    Icon(
                                        Icons.Default.Edit,
                                        contentDescription = null,
                                        tint = Color.White
                                    )
                                },
                                onClick = {
                                    showMoreMenu = false
                                    onOpenMetadataEditor(track)
                                }
                            )
                            DropdownMenuItem(
                                text = {
                                    Text(
                                        if (isFa) "اشتراک‌گذاری کارت استوری" else "Share Story Card",
                                        color = Color.White
                                    )
                                },
                                leadingIcon = {
                                    Icon(
                                        Icons.Default.Share,
                                        contentDescription = null,
                                        tint = Color.White
                                    )
                                },
                                onClick = {
                                    showMoreMenu = false
                                    onShareSong(track)
                                }
                            )
                        }
                    }
                }
            }

            // 2. Center Stage: Album Artwork or Synchronized Lyrics
            Box(
                modifier = Modifier
                    .weight(1f)
                    .fillMaxWidth()
                    .padding(vertical = 16.dp),
                contentAlignment = Alignment.Center
            ) {
                Crossfade(
                    targetState = centerView,
                    animationSpec = tween(260, easing = FastOutSlowInEasing),
                    label = "centerViewCrossfade"
                ) { viewMode ->
                    when (viewMode) {
                        NowPlayingCenterView.ARTWORK_AND_HALO -> {
                            Box(
                                modifier = Modifier.fillMaxSize(),
                                contentAlignment = Alignment.Center
                            ) {
                                Box(
                                    modifier = Modifier
                                        .fillMaxWidth()
                                        .aspectRatio(1f)
                                        .scale(artworkScale)
                                        .shadow(
                                            elevation = 24.dp,
                                            shape = RoundedCornerShape(10.dp),
                                            spotColor = Color.Black,
                                            ambientColor = Color.Black
                                        )
                                        .clip(RoundedCornerShape(10.dp))
                                        .background(Color(0xFF181818))
                                        .pointerInput(track.id) {
                                            detectTapGestures(
                                                onDoubleTap = {
                                                    triggerHaptic()
                                                    onToggleFavorite(track)
                                                },
                                                onLongPress = {
                                                    triggerHaptic()
                                                    showRadialMenu = true
                                                },
                                                onTap = {
                                                    isImmersive = !isImmersive
                                                }
                                            )
                                        },
                                    contentAlignment = Alignment.Center
                                ) {
                                    var loadedCoverBitmap by remember(track.id, track.artworkUri) {
                                        mutableStateOf(
                                            OnlineMusicRepository.getCachedCoverBitmap(
                                                track.artworkUri ?: track.id
                                            )
                                        )
                                    }
                                    LaunchedEffect(track.id, track.artworkUri) {
                                        if (loadedCoverBitmap == null) {
                                            val url = track.artworkUri?.takeIf { it.isNotBlank() }
                                                ?: OnlineMusicRepository.getCoverUrlForTrack(
                                                    track.id,
                                                    track.artist
                                                )
                                            if (!url.isNullOrBlank()) {
                                                loadedCoverBitmap =
                                                    OnlineMusicRepository.loadCoverBitmap(url)
                                            }
                                        }
                                    }

                                    val bmp = loadedCoverBitmap
                                    if (bmp != null) {
                                        Image(
                                            bitmap = bmp.asImageBitmap(),
                                            contentDescription = track.title,
                                            modifier = Modifier.fillMaxSize(),
                                            contentScale = ContentScale.Crop
                                        )
                                    } else if (!track.artworkUri.isNullOrEmpty()) {
                                        AsyncImage(
                                            model = track.artworkUri,
                                            contentDescription = track.title,
                                            modifier = Modifier.fillMaxSize(),
                                            contentScale = ContentScale.Crop
                                        )
                                    } else {
                                        MusicArtworkPlaceholder(
                                            title = track.title,
                                            artist = track.artist,
                                            trackId = track.id,
                                            palette = dynamicCoverPalette,
                                            modifier = Modifier.fillMaxSize()
                                        )
                                    }
                                }
                            }
                        }

                        NowPlayingCenterView.LYRICS -> {
                            Box(
                                modifier = Modifier
                                    .fillMaxSize()
                                    .clip(RoundedCornerShape(16.dp))
                                    .background(Color.Black.copy(alpha = 0.28f))
                                    .padding(12.dp)
                            ) {
                                LyricsView(
                                    lyrics = currentLyrics,
                                    currentPositionProvider = currentPositionProvider,
                                    displayMode = appSettings.lyricsDisplayMode,
                                    palette = dynamicCoverPalette,
                                    onSeekTo = onSeekTo,
                                    onOpenEditor = onOpenLyricsEditor,
                                    enableWordHighlight = appSettings.lyricsKaraokeWordHighlight,
                                    baseFontSize = appSettings.lyricsFontSize,
                                    activeTrackId = track.id,
                                    modifier = Modifier.fillMaxSize()
                                )
                            }
                        }
                    }
                }
            }

            // 3. Bottom Player Controls Section (Spotify Architecture)
            Column(
                modifier = Modifier.fillMaxWidth(),
                verticalArrangement = Arrangement.spacedBy(12.dp)
            ) {
                // Track Title, Artist, Download & Like Actions
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Column(modifier = Modifier.weight(1f)) {
                        Text(
                            text = track.title,
                            style = MaterialTheme.typography.headlineSmall.copy(
                                fontWeight = FontWeight.Bold,
                                color = Color.White,
                                fontSize = 22.sp
                            ),
                            maxLines = 1,
                            overflow = TextOverflow.Ellipsis
                        )
                        Spacer(modifier = Modifier.height(3.dp))
                        Text(
                            text = track.artist,
                            style = MaterialTheme.typography.bodyLarge.copy(
                                color = TextSecondary,
                                fontSize = 15.sp,
                                fontWeight = FontWeight.Medium
                            ),
                            maxLines = 1,
                            overflow = TextOverflow.Ellipsis
                        )
                    }

                    Spacer(modifier = Modifier.width(12.dp))

                    if (isOnlineTrack) {
                        IconButton(
                            onClick = {
                                triggerHaptic()
                                onDownloadTrack(track)
                            },
                            modifier = Modifier
                                .size(40.dp)
                                .testTag("download_online_track_button")
                        ) {
                            when {
                                isDownloadingNow -> {
                                    Box(contentAlignment = Alignment.Center) {
                                        CircularProgressIndicator(
                                            progress = {
                                                (currentDownloadProgress / 100f).coerceIn(0.05f, 1f)
                                            },
                                            color = AuraSpotifyGreen,
                                            strokeWidth = 2.dp,
                                            modifier = Modifier.size(24.dp)
                                        )
                                    }
                                }
                                isDownloadedToPhone -> {
                                    Icon(
                                        imageVector = Icons.Default.CheckCircle,
                                        contentDescription = "Downloaded",
                                        tint = AuraSpotifyGreen,
                                        modifier = Modifier.size(24.dp)
                                    )
                                }
                                else -> {
                                    Icon(
                                        imageVector = Icons.Default.DownloadForOffline,
                                        contentDescription = "Download",
                                        tint = TextSecondary,
                                        modifier = Modifier.size(24.dp)
                                    )
                                }
                            }
                        }
                    }

                    IconButton(
                        onClick = {
                            triggerHaptic()
                            onToggleFavorite(track)
                        },
                        modifier = Modifier.size(40.dp)
                    ) {
                        Icon(
                            imageVector = if (track.isFavorite) Icons.Default.Favorite else Icons.Default.FavoriteBorder,
                            contentDescription = "Favorite",
                            tint = if (track.isFavorite) AuraSpotifyGreen else Color.White,
                            modifier = Modifier.size(26.dp)
                        )
                    }
                }

                // Seek Bar
                val dur = if (playbackState.durationMs > 1000L) {
                    playbackState.durationMs
                } else if (track.durationMs > 0) {
                    track.durationMs
                } else {
                    1L
                }

                LiquidGlassProgressBar(
                    currentPositionProvider = currentPositionProvider,
                    durationMs = dur,
                    palette = dynamicCoverPalette,
                    analysisDataProvider = analysisDataProvider,
                    onSeekTo = onSeekTo,
                    waveformEnvelope = waveformFloats,
                    loopStartMs = loopStartMs,
                    loopEndMs = loopEndMs,
                    modifier = Modifier.fillMaxWidth()
                )

                // Main Transport Controls (Shuffle, Previous, Play/Pause, Next, Repeat)
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    // Shuffle Button with Spotify Active Dot
                    Column(horizontalAlignment = Alignment.CenterHorizontally) {
                        IconButton(
                            onClick = {
                                triggerHaptic()
                                onToggleShuffle()
                            },
                            modifier = Modifier.size(40.dp)
                        ) {
                            Icon(
                                imageVector = Icons.Default.Shuffle,
                                contentDescription = "Shuffle",
                                tint = if (playbackState.isShuffle) AuraSpotifyGreen else Color.White.copy(alpha = 0.8f),
                                modifier = Modifier.size(22.dp)
                            )
                        }
                        Box(
                            modifier = Modifier
                                .size(4.dp)
                                .clip(CircleShape)
                                .background(if (playbackState.isShuffle) AuraSpotifyGreen else Color.Transparent)
                        )
                    }

                    IconButton(
                        onClick = {
                            triggerHaptic()
                            onPrevious()
                        },
                        modifier = Modifier.size(52.dp)
                    ) {
                        Icon(
                            imageVector = Icons.Default.SkipPrevious,
                            contentDescription = "Previous",
                            tint = Color.White,
                            modifier = Modifier.size(36.dp)
                        )
                    }

                    SpotifyPlayPauseButton(
                        isPlaying = isPlaying,
                        onClick = {
                            triggerHaptic()
                            onTogglePlay()
                        }
                    )

                    IconButton(
                        onClick = {
                            triggerHaptic()
                            onNext()
                        },
                        modifier = Modifier.size(52.dp)
                    ) {
                        Icon(
                            imageVector = Icons.Default.SkipNext,
                            contentDescription = "Next",
                            tint = Color.White,
                            modifier = Modifier.size(36.dp)
                        )
                    }

                    // Repeat Button with Spotify Active Dot
                    val isRepeatActive = playbackState.repeatMode != PlaybackRepeatMode.OFF
                    Column(horizontalAlignment = Alignment.CenterHorizontally) {
                        IconButton(
                            onClick = {
                                triggerHaptic()
                                onCycleRepeat()
                            },
                            modifier = Modifier.size(40.dp)
                        ) {
                            val repIcon = when (playbackState.repeatMode) {
                                PlaybackRepeatMode.ONE -> Icons.Default.RepeatOne
                                PlaybackRepeatMode.ALL -> Icons.Default.Repeat
                                PlaybackRepeatMode.OFF -> Icons.Default.Repeat
                            }
                            Icon(
                                imageVector = repIcon,
                                contentDescription = "Repeat",
                                tint = if (isRepeatActive) AuraSpotifyGreen else Color.White.copy(alpha = 0.8f),
                                modifier = Modifier.size(22.dp)
                            )
                        }
                        Box(
                            modifier = Modifier
                                .size(4.dp)
                                .clip(CircleShape)
                                .background(if (isRepeatActive) AuraSpotifyGreen else Color.Transparent)
                        )
                    }
                }

                // Subtle Volume Slider
                LiquidGlassVolumeControl(
                    palette = dynamicCoverPalette,
                    modifier = Modifier.fillMaxWidth()
                )

                // Bottom Utility Row (Devices/Lyrics, A-B Loop, Speed, Share, Queue)
                Row(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(top = 2.dp),
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    // Lyrics View Switch
                    val isLyricsSelected = centerView == NowPlayingCenterView.LYRICS
                    Row(
                        modifier = Modifier
                            .clip(RoundedCornerShape(50))
                            .background(if (isLyricsSelected) AuraSpotifyGreen.copy(alpha = 0.2f) else Color.White.copy(alpha = 0.08f))
                            .clickable {
                                triggerHaptic()
                                centerView = if (isLyricsSelected) {
                                    NowPlayingCenterView.ARTWORK_AND_HALO
                                } else {
                                    NowPlayingCenterView.LYRICS
                                }
                            }
                            .padding(horizontal = 12.dp, vertical = 6.dp),
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Icon(
                            imageVector = Icons.Default.Lyrics,
                            contentDescription = null,
                            tint = if (isLyricsSelected) AuraSpotifyGreen else Color.White,
                            modifier = Modifier.size(16.dp)
                        )
                        Spacer(modifier = Modifier.width(6.dp))
                        Text(
                            text = if (isFa) "متن آهنگ" else "Lyrics",
                            color = if (isLyricsSelected) AuraSpotifyGreen else Color.White,
                            fontSize = 12.sp,
                            fontWeight = FontWeight.SemiBold
                        )
                    }

                    // A-B Loop Pill
                    val isAbActive = loopStartMs != null
                    Box(
                        modifier = Modifier
                            .clip(RoundedCornerShape(50))
                            .background(if (isAbActive) AuraSpotifyGreen.copy(alpha = 0.2f) else Color.White.copy(alpha = 0.08f))
                            .clickable {
                                triggerHaptic()
                                val nowPos = currentPositionProvider()
                                when {
                                    loopStartMs == null -> onSetAbLoop(nowPos, null)
                                    loopEndMs == null -> {
                                        if (nowPos > loopStartMs + 800L) {
                                            onSetAbLoop(loopStartMs, nowPos)
                                        } else {
                                            onSetAbLoop(
                                                loopStartMs,
                                                (loopStartMs + 5000L).coerceAtMost(dur)
                                            )
                                        }
                                    }
                                    else -> onClearAbLoop()
                                }
                            }
                            .padding(horizontal = 10.dp, vertical = 6.dp)
                    ) {
                        val abLabel = when {
                            loopStartMs == null -> "A-B"
                            loopEndMs == null -> "A→..."
                            else -> "A⟲B"
                        }
                        Text(
                            text = abLabel,
                            color = if (isAbActive) AuraSpotifyGreen else Color.White,
                            fontSize = 11.5.sp,
                            fontWeight = FontWeight.Bold
                        )
                    }

                    // Playback Speed Pill
                    Box(
                        modifier = Modifier
                            .clip(RoundedCornerShape(50))
                            .background(Color.White.copy(alpha = 0.08f))
                            .clickable {
                                triggerHaptic()
                                val nextSpeed = when (appSettings.playbackSpeed) {
                                    1.0f -> 1.25f
                                    1.25f -> 1.5f
                                    1.5f -> 2.0f
                                    else -> 1.0f
                                }
                                onPlaybackSpeedChange(nextSpeed)
                            }
                            .padding(horizontal = 10.dp, vertical = 6.dp)
                    ) {
                        Text(
                            text = "${appSettings.playbackSpeed}x",
                            color = Color.White,
                            fontSize = 12.sp,
                            fontWeight = FontWeight.SemiBold
                        )
                    }

                    Row(
                        horizontalArrangement = Arrangement.spacedBy(4.dp),
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        IconButton(
                            onClick = {
                                triggerHaptic()
                                onShareSong(track)
                            },
                            modifier = Modifier.size(36.dp)
                        ) {
                            Icon(
                                imageVector = Icons.Default.Share,
                                contentDescription = "Share",
                                tint = TextSecondary,
                                modifier = Modifier.size(20.dp)
                            )
                        }

                        IconButton(
                            onClick = {
                                triggerHaptic()
                                onOpenQueue()
                            },
                            modifier = Modifier.size(36.dp)
                        ) {
                            Icon(
                                imageVector = Icons.Default.QueueMusic,
                                contentDescription = "Queue",
                                tint = TextSecondary,
                                modifier = Modifier.size(22.dp)
                            )
                        }
                    }
                }
            }
        }

        if (showRadialMenu) {
            RadialActionMenu(
                track = track,
                palette = dynamicCoverPalette,
                hapticEnabled = appSettings.hapticFeedbackEnabled,
                onDismiss = { showRadialMenu = false },
                onPlayNext = { onNext() },
                onAddToQueue = { onOpenQueue() },
                onToggleFavorite = { onToggleFavorite(track) },
                onAddToPlaylist = { onOpenMetadataEditor(track) },
                onShare = { onShareSong(track) }
            )
        }

        if (appSettings.developerModeEnabled) {
            DeveloperHud(
                analysisDataProvider = analysisDataProvider,
                playbackState = playbackState,
                modifier = Modifier
                    .align(Alignment.TopStart)
                    .padding(top = 80.dp, start = 16.dp)
            )
        }
    }
