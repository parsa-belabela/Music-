            horizontalAlignment = Alignment.CenterHorizontally
        ) {
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {
                Row(verticalAlignment = Alignment.CenterVertically) {
                    Icon(
                        imageVector = Icons.Default.Star,
                        contentDescription = null,
                        tint = Color(0xFFFFD54F),
                        modifier = Modifier.size(26.dp)
                    )
                    Spacer(modifier = Modifier.width(8.dp))
                    Text(
                        text = if (isVip) "💎 اشتراک VIP شما فعال است" else vipConfig.productTitle,
                        fontSize = 20.sp,
                        fontWeight = FontWeight.Bold,
                        color = Color.White
                    )
                }
                IconButton(onClick = onDismiss) {
                    Icon(Icons.Default.Close, contentDescription = "Close", tint = Color.White.copy(alpha = 0.7f))
                }
            }

            Spacer(modifier = Modifier.height(12.dp))

            // بنر تخفیف و ظرفیت زنده از کلادفلر
            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .clip(RoundedCornerShape(16.dp))
                    .background(
                        Brush.horizontalGradient(
                            listOf(Color(0xFF6A1B9A), Color(0xFF283593))
                        )
                    )
                    .border(1.dp, Color.White.copy(alpha = 0.18f), RoundedCornerShape(16.dp))
                    .padding(14.dp)
            ) {
                Column(horizontalAlignment = Alignment.CenterHorizontally, modifier = Modifier.fillMaxWidth()) {
                    Text(
                        text = vipConfig.bannerText,
                        color = Color.White,
                        fontSize = 14.sp,
                        fontWeight = FontWeight.SemiBold,
                        textAlign = TextAlign.Center
                    )
                    Spacer(modifier = Modifier.height(6.dp))
                    Text(
                        text = "ظرفیت باقی‌مانده: ${vipConfig.remainingCapacity} از ${vipConfig.totalCapacity} نفر",
                        color = Color(0xFFFFD54F),
                        fontSize = 13.sp,
                        fontWeight = FontWeight.Bold
                    )
                }
            }

            Spacer(modifier = Modifier.height(16.dp))

            // نمایش قیمت اصلی و قیمت با تخفیف
            Row(
                verticalAlignment = Alignment.CenterVertically,
                horizontalArrangement = Arrangement.Center
            ) {
                Text(
                    text = "${"%,d".format(vipConfig.originalPriceToman)} تومان",
                    color = Color.White.copy(alpha = 0.45f),
                    fontSize = 15.sp,
                    textDecoration = TextDecoration.LineThrough
                )
                Spacer(modifier = Modifier.width(12.dp))
                Text(
                    text = "${"%,d".format(vipConfig.discountPriceToman)} تومان (مادام‌العمر)",
                    color = Color(0xFF4ADE80),
                    fontSize = 19.sp,
                    fontWeight = FontWeight.ExtraBold
                )
            }

            Spacer(modifier = Modifier.height(18.dp))

            // دکمه خرید مستقیم از مایکت (شناسه yu-15)
            Button(
                onClick = {
                    if (isVip) {
                        onVipUnlocked()
                        onDismiss()
                    } else {
                        onStartMyketPurchase?.invoke(vipConfig.sku)
                    }
                },
                enabled = !isLoading && (vipConfig.salesOpen || isVip),
                modifier = Modifier
                    .fillMaxWidth()
                    .height(54.dp),
                shape = RoundedCornerShape(16.dp),
                colors = ButtonDefaults.buttonColors(containerColor = Color(0xFF9333EA))
            ) {
                Text(
                    text = if (isVip) "✅ شما کاربر VIP پریمیوم هستید (ورود)"
                    else if (vipConfig.salesOpen) "خرید اشتراک پریمیوم از مایکت (${vipConfig.sku})"
                    else "ظرفیت فروش تکمیل شده است",
                    fontSize = 16.sp,
                    fontWeight = FontWeight.Bold,
                    color = Color.White
                )
            }

            Spacer(modifier = Modifier.height(18.dp))
            HorizontalDivider(color = Color.White.copy(alpha = 0.1f))
            Spacer(modifier = Modifier.height(14.dp))

            // بخش وارد کردن کد تخفیف / کد هدیه VIP
            Text(
                text = "کد تخفیف یا کد فعال‌سازی VIP دارید؟",
                color = Color.White.copy(alpha = 0.8f),
                fontSize = 14.sp,
                fontWeight = FontWeight.Medium
            )
            Spacer(modifier = Modifier.height(8.dp))

            Row(
                modifier = Modifier.fillMaxWidth(),
                verticalAlignment = Alignment.CenterVertically
            ) {
                OutlinedTextField(
                    value = promoCode,
                    onValueChange = { promoCode = it },
                    placeholder = { Text("مثلاً: AURAVIP", color = Color.White.copy(alpha = 0.4f)) },
                    singleLine = true,
                    modifier = Modifier.weight(1f),
                    shape = RoundedCornerShape(14.dp),
                    colors = OutlinedTextFieldDefaults.colors(
                        focusedBorderColor = Color(0xFFA855F7),
                        unfocusedBorderColor = Color.White.copy(alpha = 0.25f),
                        focusedTextColor = Color.White,
                        unfocusedTextColor = Color.White
                    )
                )
                Spacer(modifier = Modifier.width(10.dp))
                Button(
                    onClick = {
                        scope.launch {
                            isLoading = true
                            statusMessage = null
                            val res = entitlementManager.redeemPromoCode(promoCode)
                            isLoading = false
                            if (res.isSuccess) {
                                isError = false
                                statusMessage = res.getOrNull()
                                onVipUnlocked()
                            } else {
                                isError = true
                                statusMessage = res.exceptionOrNull()?.message ?: "کد نامعتبر است"
                            }
                        }
                    },
                    enabled = !isLoading && promoCode.isNotBlank(),
                    modifier = Modifier.height(54.dp),
                    shape = RoundedCornerShape(14.dp),
                    colors = ButtonDefaults.buttonColors(containerColor = Color(0xFF2563EB))
                ) {
                    if (isLoading) {
                        CircularProgressIndicator(
                            modifier = Modifier.size(20.dp),
                            color = Color.White,
                            strokeWidth = 2.dp
                        )
                    } else {
                        Text("اعمال کد", fontWeight = FontWeight.Bold, color = Color.White)
                    }
                }
            }

            if (!statusMessage.isNullOrBlank()) {
                Spacer(modifier = Modifier.height(12.dp))
                Row(
                    verticalAlignment = Alignment.CenterVertically,
                    modifier = Modifier
                        .fillMaxWidth()
                        .clip(RoundedCornerShape(12.dp))
                        .background(if (isError) Color(0x33EF4444) else Color(0x3322C55E))
                        .padding(12.dp)
                ) {
                    Icon(
                        imageVector = Icons.Default.CheckCircle,
                        contentDescription = null,
                        tint = if (isError) Color(0xFFF87171) else Color(0xFF4ADE80)
                    )
                    Spacer(modifier = Modifier.width(8.dp))
                    Text(
                        text = statusMessage!!,
                        color = if (isError) Color(0xFFFCA5A5) else Color(0xFF86EFAC),
                        fontSize = 13.sp,
                        fontWeight = FontWeight.Medium
                    )
                }
            }

            Spacer(modifier = Modifier.height(16.dp))
        }
    }
}

۴. کد کامل فایل سوم: صفحه سرچ و پخش آنلاین متصل به کلادفلر
📂 مسیر فایل در پروژه:
app/src/main/java/com/example/OnlineMusicScreen.kt
(تغییرات: رفع کامل مشکل نیامدن لیست آهنگ‌ها از کلادفلر، رفرش خودکار لیست بلافاصله بعد از زدن کد تخفیف و VIP شدن، نمایش بج «💎 کاربر VIP پریمیوم»، پخش مستقیم آهنگ‌ها при کلیک روی هر آهنگ، نمایش عکس واقعی خواننده‌ها و فرم ارسال درخواست آهنگ به کانال تلگرام)
package com.example

import android.media.AudioAttributes
import android.media.MediaPlayer
import androidx.compose.foundation.background
import androidx.compose.foundation.border
import androidx.compose.foundation.clickable
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.lazy.LazyColumn
import androidx.compose.foundation.lazy.LazyRow
import androidx.compose.foundation.lazy.items
import androidx.compose.foundation.shape.CircleShape
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.material.icons.Icons
import androidx.compose.material.icons.filled.*
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.draw.clip
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.layout.ContentScale
import androidx.compose.ui.platform.LocalContext
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.text.style.TextOverflow
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp
import coil.compose.AsyncImage
import com.example.monetization.EntitlementManager
import com.example.ui.components.VipPaywallSheet
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.delay
import kotlinx.coroutines.launch
import kotlinx.coroutines.withContext
import org.json.JSONArray
import org.json.JSONObject
import java.net.HttpURLConnection
import java.net.URL
import java.net.URLEncoder

data class CloudTrackItem(
    val id: String,
    val title: String,
    val artist: String,
    val album: String,
    val duration: Int,
    val streamUrl: String,
    val coverUrl: String,
    val artistPicUrl: String
)

data class CloudArtistItem(
    val name: String,
    val trackCount: Int,
    val pictureUrl: String
)

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun OnlineMusicScreen(
    modifier: Modifier = Modifier,
    onPlayCloudTrack: ((CloudTrackItem) -> Unit)? = null
) {
    val context = LocalContext.current
    val entitlementManager = remember { EntitlementManager.getInstance(context) }
    val isVip by entitlementManager.isVip.collectAsState()
    val scope = rememberCoroutineScope()

    var searchQuery by remember { mutableStateOf("") }
    var selectedArtist by remember { mutableStateOf<String?>(null) }
    var tracks by remember { mutableStateOf<List<CloudTrackItem>>(emptyList()) }
    var artists by remember { mutableStateOf<List<CloudArtistItem>>(emptyList()) }
    var isLoading by remember { mutableStateOf(true) }
    var errorMessage by remember { mutableStateOf<String?>(null) }

    var showPaywall by remember { mutableStateOf(false) }
    var showRequestDialog by remember { mutableStateOf(false) }

    // پلیر داخلی در صورتی که کال‌بک بیرونی پاس داده نشده باشد
    var currentPlayingTrack by remember { mutableStateOf<CloudTrackItem?>(null) }
    var isPlayingAudio by remember { mutableStateOf(false) }
    val mediaPlayer = remember { MediaPlayer() }

    DisposableEffect(Unit) {
        onDispose {
            try {
                if (mediaPlayer.isPlaying) mediaPlayer.stop()
                mediaPlayer.release()
            } catch (_: Exception) {}
        }
    }

    fun playTrackNow(item: CloudTrackItem) {
        if (!isVip) {
            showPaywall = true
            return
        }
        if (onPlayCloudTrack != null) {
            onPlayCloudTrack(item)
            return
        }
        currentPlayingTrack = item
        isPlayingAudio = false
        scope.launch(Dispatchers.IO) {
            try {
                mediaPlayer.reset()
                mediaPlayer.setAudioAttributes(
                    AudioAttributes.Builder()
                        .setContentType(AudioAttributes.CONTENT_TYPE_MUSIC)
                        .setUsage(AudioAttributes.USAGE_MEDIA)
                        .build()
                )
                mediaPlayer.setDataSource(item.streamUrl)
                mediaPlayer.setOnPreparedListener { mp ->
                    mp.start()
                    isPlayingAudio = true
                }
                mediaPlayer.prepareAsync()
            } catch (e: Exception) {
                e.printStackTrace()
            }
        }
    }

    suspend fun loadCatalogFromCloudflare(query: String, artistFilter: String?) {
        isLoading = true
        errorMessage = null
        withContext(Dispatchers.IO) {
            try {
                val baseUrl = EntitlementManager.CLOUDFLARE_WORKER_URL.trimEnd('/')
                val deviceId = entitlementManager.getHardwareDeviceId()
                val encodedQ = URLEncoder.encode(query.trim(), "UTF-8")
                val encodedArtist = URLEncoder.encode(artistFilter ?: "", "UTF-8")
                val fullUrl = "$baseUrl/tracks?q=$encodedQ&artist=$encodedArtist&deviceId=$deviceId"

                val conn = (URL(fullUrl).openConnection() as HttpURLConnection).apply {
                    requestMethod = "GET"
                    connectTimeout = 10000
                    readTimeout = 10000
                    setRequestProperty("X-Device-Id", deviceId)
                }

                if (conn.responseCode in 200..299) {
                    val raw = conn.inputStream.bufferedReader().use { it.readText() }
                    val root = JSONObject(raw)

                    // استخراج لیست آهنگ‌ها (پشتیبانی از هر ۳ کلید tracks, data, results)
                    val tracksArr: JSONArray = root.optJSONArray("tracks")
                        ?: root.optJSONArray("data")
                        ?: root.optJSONArray("results")
                        ?: JSONArray()

                    val parsedTracks = ArrayList<CloudTrackItem>(tracksArr.length())
                    for (i in 0 until tracksArr.length()) {
                        val obj = tracksArr.optJSONObject(i) ?: continue
                        val id = obj.optString("id", "")
                        if (id.isBlank()) continue

                        val title = obj.optString("title", "Unknown Track")
                        val artistObj = obj.optJSONObject("artist")
                        val artistName = obj.optString("artist_name").ifBlank {
                            obj.optString("artistName").ifBlank {
                                artistObj?.optString("name") ?: obj.optString("artist", "Unknown Artist")
                            }
                        }
                        val albumName = obj.optString("album", "Single")
                            .let { if (it.startsWith("{") || it.contains("title=")) "Single" else it }

                        val stream = obj.optString("stream_url").ifBlank {
                            obj.optString("streamUrl").ifBlank {
                                obj.optString("preview").ifBlank { "$baseUrl/stream?id=$id" }
                            }
                        }
                        val cover = obj.optString("cover_url").ifBlank {
                            obj.optString("coverUrl").ifBlank {
                                obj.optString("cover").ifBlank { "$baseUrl/cover?id=$id&v=hd6" }
                            }
                        }
                        val artistPic = obj.optString("artist_picture").ifBlank {
                            artistObj?.optString("picture")
                                ?: "$baseUrl/artist-cover?name=${URLEncoder.encode(artistName, "UTF-8")}&id=$id&v=hd6"
                        }

                        parsedTracks.add(
                            CloudTrackItem(
                                id = id,
                                title = title,
                                artist = artistName,
                                album = albumName,
                                duration = obj.optInt("duration", 200),
                                streamUrl = stream,
                                coverUrl = cover,
                                artistPicUrl = artistPic
                            )
                        )
                    }

                    val artistsArr = root.optJSONArray("artists") ?: JSONArray()
                    val parsedArtists = ArrayList<CloudArtistItem>(artistsArr.length())
                    for (j in 0 until artistsArr.length()) {
                        val aObj = artistsArr.optJSONObject(j) ?: continue
                        val name = aObj.optString("name", "")
                        if (name.isBlank()) continue
                        val pic = aObj.optString("picture").ifBlank {
                            aObj.optString("cover").ifBlank {
                                "$baseUrl/artist-cover?name=${URLEncoder.encode(name, "UTF-8")}&v=hd6"
                            }
                        }
                        parsedArtists.add(
                            CloudArtistItem(
                                name = name,
                                trackCount = aObj.optInt("trackCount", 1),
                                pictureUrl = pic
                            )
                        )
                    }

                    withContext(Dispatchers.Main) {
                        tracks = parsedTracks
                        if (artistFilter.isNullOrBlank()) {
                            artists = parsedArtists
                        }
                        isLoading = false
                    }
                } else {
                    withContext(Dispatchers.Main) {
                        errorMessage = "خطا در دریافت لیست آهنگ‌ها از سرور (کد ${conn.responseCode})"
                        isLoading = false
                    }
                }
            } catch (e: Exception) {
                withContext(Dispatchers.Main) {
                    errorMessage = "عدم ارتباط با کلادفلر: آدرس ورکر یا اینترنت خود را بررسی کنید."
                    isLoading = false
                }
            }
        }
    }

    // به محض تغییر سرچ، تغییر فیلتر خواننده یا VIP شدن کاربر، لیست آهنگ‌ها از کلادفلر لود می‌شود
    LaunchedEffect(searchQuery, selectedArtist, isVip) {
        if (searchQuery.isNotEmpty()) delay(250)
        loadCatalogFromCloudflare(searchQuery, selectedArtist)
    }

    Column(
        modifier = modifier
            .fillMaxSize()
            .background(Color(0xFF090B10))
            .padding(horizontal = 16.dp, vertical = 10.dp)
    ) {
        // نوار وضعیت کاربر (VIP یا عادی) + دکمه درخواست آهنگ
        Row(
            modifier = Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.SpaceBetween,
            verticalAlignment = Alignment.CenterVertically
        ) {
            Surface(
                shape = RoundedCornerShape(50),
                color = if (isVip) Color(0xFF1E3A2F) else Color(0xFF27203A),
                modifier = Modifier.clickable {
                    if (!isVip) showPaywall = true
                }
            ) {
                Row(
                    modifier = Modifier.padding(horizontal = 12.dp, vertical = 6.dp),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Icon(
                        imageVector = if (isVip) Icons.Default.CheckCircle else Icons.Default.Lock,
                        contentDescription = null,
                        tint = if (isVip) Color(0xFF4ADE80) else Color(0xFFFFD54F),
                        modifier = Modifier.size(16.dp)
                    )
                    Spacer(modifier = Modifier.width(6.dp))
                    Text(
                        text = if (isVip) "💎 کاربر VIP پریمیوم" else "👤 کاربر عادی (ارتقا به VIP)",
                        color = Color.White,
                        fontSize = 12.sp,
                        fontWeight = FontWeight.Bold
                    )
                }
            }

            Row {
                IconButton(onClick = { scope.launch { loadCatalogFromCloudflare(searchQuery, selectedArtist) } }) {
                    Icon(Icons.Default.Refresh, contentDescription = "Refresh", tint = Color.White)
                }
                Button(
                    onClick = {
                        if (isVip) showRequestDialog = true else showPaywall = true
                    },
                    shape = RoundedCornerShape(50),
                    colors = ButtonDefaults.buttonColors(containerColor = Color(0xFF7C3AED)),
                    contentPadding = PaddingValues(horizontal = 14.dp, vertical = 6.dp)
                ) {
                    Icon(Icons.Default.Add, contentDescription = null, modifier = Modifier.size(16.dp))
                    Spacer(modifier = Modifier.width(4.dp))
                    Text("درخواست آهنگ", fontSize = 12.sp, fontWeight = FontWeight.Bold)
                }
            }
        }

        Spacer(modifier = Modifier.height(10.dp))

        // کادر جستجوی سریع آهنگ، خواننده یا آلبوم
        OutlinedTextField(
            value = searchQuery,
            onValueChange = { searchQuery = it },
            placeholder = { Text("جستجوی نام آهنگ یا خواننده در آرشیو...", color = Color.White.copy(alpha = 0.45f)) },
            leadingIcon = { Icon(Icons.Default.Search, contentDescription = null, tint = Color(0xFFA855F7)) },
            trailingIcon = {
                if (searchQuery.isNotEmpty() || selectedArtist != null) {
                    IconButton(onClick = {
                        searchQuery = ""
                        selectedArtist = null
                    }) {
                        Icon(Icons.Default.Close, contentDescription = "Clear", tint = Color.White)
                    }
                }
            },
            singleLine = true,
            modifier = Modifier.fillMaxWidth(),
            shape = RoundedCornerShape(16.dp),
            colors = OutlinedTextFieldDefaults.colors(
                focusedBorderColor = Color(0xFFA855F7),
                unfocusedBorderColor = Color.White.copy(alpha = 0.15f),
                focusedTextColor = Color.White,
                unfocusedTextColor = Color.White
            )
        )

        // ردیف خواننده‌ها با عکس واقعی بدون فیلتر
        if (artists.isNotEmpty()) {
            Spacer(modifier = Modifier.height(12.dp))
            LazyRow(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
                items(artists) { artist ->
                    val isSelected = selectedArtist == artist.name
                    Column(
                        horizontalAlignment = Alignment.CenterHorizontally,
                        modifier = Modifier
                            .width(76.dp)
                            .clickable {
                                selectedArtist = if (isSelected) null else artist.name
                            }
                    ) {
                        AsyncImage(
                            model = artist.pictureUrl,
                            contentDescription = artist.name,
                            contentScale = ContentScale.Crop,
                            modifier = Modifier
                                .size(62.dp)
                                .clip(CircleShape)
                                .border(
                                    width = if (isSelected) 2.5.dp else 1.dp,
                                    color = if (isSelected) Color(0xFFA855F7) else Color.White.copy(alpha = 0.2f),
                                    shape = CircleShape
                                )
                        )
                        Spacer(modifier = Modifier.height(4.dp))
                        Text(
                            text = artist.name,
                            color = if (isSelected) Color(0xFFD8B4FE) else Color.White,
                            fontSize = 11.sp,
                            maxLines = 1,
                            overflow = TextOverflow.Ellipsis,
                            fontWeight = if (isSelected) FontWeight.Bold else FontWeight.Normal
                        )
                    }
                }
            }
        }

        Spacer(modifier = Modifier.height(12.dp))

        // نمایش لیست آهنگ‌ها
        Box(modifier = Modifier.weight(1f).fillMaxWidth()) {
            when {
                isLoading -> {
                    CircularProgressIndicator(
                        color = Color(0xFFA855F7),
                        modifier = Modifier.align(Alignment.Center)
                    )
                }
                errorMessage != null -> {
                    Column(
                        modifier = Modifier.align(Alignment.Center),
                        horizontalAlignment = Alignment.CenterHorizontally
                    ) {
                        Text(errorMessage!!, color = Color(0xFFF87171), fontSize = 14.sp)
                        Spacer(modifier = Modifier.height(8.dp))
                        Button(onClick = { scope.launch { loadCatalogFromCloudflare(searchQuery, selectedArtist) } }) {
                            Text("تلاش مجدد")
                        }
                    }
                }
                tracks.isEmpty() -> {
                    Text(
                        text = "آهنگی با این مشخصات در آرشیو پیدا نشد.",
                        color = Color.White.copy(alpha = 0.6f),
                        modifier = Modifier.align(Alignment.Center)
                    )
                }
                else -> {
                    LazyColumn(
                        verticalArrangement = Arrangement.spacedBy(10.dp),
                        contentPadding = PaddingValues(bottom = 80.dp)
                    ) {
                        items(tracks, key = { it.id }) { track ->
                            val isThisPlaying = currentPlayingTrack?.id == track.id && isPlayingAudio
                            Row(
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .clip(RoundedCornerShape(16.dp))
                                    .background(
                                        if (isThisPlaying) Color(0xFF2E1065) else Color(0xFF141824)
                                    )
                                    .clickable { playTrackNow(track) }
                                    .padding(10.dp),
                                verticalAlignment = Alignment.CenterVertically
                            ) {
                                AsyncImage(
                                    model = track.coverUrl,
                                    contentDescription = track.title,
                                    contentScale = ContentScale.Crop,
                                    modifier = Modifier
                                        .size(56.dp)
                                        .clip(RoundedCornerShape(12.dp))
                                )
                                Spacer(modifier = Modifier.width(12.dp))
                                Column(modifier = Modifier.weight(1f)) {
                                    Text(
                                        text = track.title,
                                        color = Color.White,
                                        fontSize = 15.sp,
                                        fontWeight = FontWeight.Bold,
                                        maxLines = 1,
                                        overflow = TextOverflow.Ellipsis
                                    )
                                    Spacer(modifier = Modifier.height(3.dp))
                                    Text(
                                        text = "${track.artist} • ${track.album}",
                                        color = Color.White.copy(alpha = 0.65f),
                                        fontSize = 12.sp,
                                        maxLines = 1,
                                        overflow = TextOverflow.Ellipsis
                                    )
                                }
                                IconButton(onClick = { playTrackNow(track) }) {
                                    Icon(
                                        imageVector = if (!isVip) Icons.Default.Lock
                                        else if (isThisPlaying) Icons.Default.Pause
                                        else Icons.Default.PlayArrow,
                                        contentDescription = "Play",
                                        tint = if (isVip) Color(0xFFA855F7) else Color(0xFFFFD54F)
                                    )
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // پنجره خرید اشتراک و کد تخفیف
    if (showPaywall) {
        VipPaywallSheet(
            onDismiss = { showPaywall = false },
            onVipUnlocked = {
                showPaywall = false
                scope.launch {
                    loadCatalogFromCloudflare(searchQuery, selectedArtist)
                }
            }
        )
    }

    // دیالوگ ارسال درخواست آهنگ به کانال تلگرام
    if (showRequestDialog) {
        var reqTitle by remember { mutableStateOf("") }
        var reqArtist by remember { mutableStateOf("") }
        var reqNote by remember { mutableStateOf("") }
        var reqStatus by remember { mutableStateOf<String?>(null) }
        var sendingReq by remember { mutableStateOf(false) }

        AlertDialog(
            onDismissRequest = { showRequestDialog = false },
            containerColor = Color(0xFF141824),
            title = { Text("🎵 درخواست افزودن آهنگ به آرشیو", color = Color.White, fontSize = 18.sp, fontWeight = FontWeight.Bold) },
            text = {
                Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {
                    OutlinedTextField(
                        value = reqTitle,
                        onValueChange = { reqTitle = it },
                        label = { Text("نام آهنگ") },
                        singleLine = true
                    )
                    OutlinedTextField(
                        value = reqArtist,
                        onValueChange = { reqArtist = it },
                        label = { Text("نام خواننده") },
                        singleLine = true
                    )
                    OutlinedTextField(
                        value = reqNote,
                        onValueChange = { reqNote = it },
                        label = { Text("توضیحات اختیاری") },
                        singleLine = true
                    )
                    if (!reqStatus.isNullOrBlank()) {
                        Text(reqStatus!!, color = Color(0xFF4ADE80), fontSize = 13.sp)
                    }
                }
            },
            confirmButton = {
                Button(
                    enabled = !sendingReq && (reqTitle.isNotBlank() || reqArtist.isNotBlank()),
                    onClick = {
                        scope.launch {
                            sendingReq = true
                            val res = entitlementManager.submitSongRequest(reqTitle, reqArtist, reqNote)
                            sendingReq = false
                            reqStatus = res.getOrNull() ?: res.exceptionOrNull()?.message
                            if (res.isSuccess) {
                                delay(1200)
                                showRequestDialog = false
                            }
                        }
                    }
                ) {
                    Text(if (sendingReq) "در حال ارسال..." else "ارسال به کانال")
                }
            },
            dismissButton = {
                TextButton(onClick = { showRequestDialog = false }) {
                    Text("بستن", color = Color.White.copy(alpha = 0.7f))
                }
            }
        )
    }
}

چطور تست کنی؟
 * در فایل EntitlementManager.kt خط ۴۱، آدرس دقیق ورکر کلادفلر خودت را در CLOUDFLARE_WORKER_URL بگذار.
 * وقتی وارد برنامه شدی، روی دکمه ارتقا به VIP کلیک کن و در کادر کد تخفیف بنویس AURAVIP (یا هر کدی که با AURA یا VIP شروع شود) و دکمه اعمال کد را بزن.
 * در همان ثانیه پیام سبز رنگ تایید نمایش داده می‌شود، وضعیت بالای صفحه سرچ به «💎 کاربر VIP پریمیوم» تغییر می‌کند، لیست آهنگ‌ها از کلادفلر لود می‌شود و با کلیک روی هر آهنگ بدون محدودیت پخش می‌شود.
