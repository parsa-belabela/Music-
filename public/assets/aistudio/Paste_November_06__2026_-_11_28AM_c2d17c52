                                    onDone = {
                                        focusManager.clearFocus()
                                        entitlementManager.applyPromoCode(promoCodeInput)
                                    }
                                ),
                                colors = OutlinedTextFieldDefaults.colors(
                                    focusedBorderColor = Color(0xFF6C63FF),
                                    unfocusedBorderColor = Color.White.copy(alpha = 0.2f),
                                    focusedTextColor = Color.White,
                                    unfocusedTextColor = Color.White
                                ),
                                shape = RoundedCornerShape(12.dp),
                                modifier = Modifier.weight(1f)
                            )
                        }
                    }
                }
            }

            // نمایش پیام وضعیت (موفقیت یا خطا)
            when (val state = purchaseState) {
                is PurchaseUiState.Error -> {
                    Spacer(modifier = Modifier.height(12.dp))
                    Text(
                        text = state.message,
                        color = Color(0xFFFF5252),
                        fontSize = 13.sp,
                        textAlign = TextAlign.Center,
                        modifier = Modifier.fillMaxWidth()
                    )
                }
                is PurchaseUiState.Success -> {
                    Spacer(modifier = Modifier.height(12.dp))
                    Row(
                        verticalAlignment = Alignment.CenterVertically,
                        horizontalArrangement = Arrangement.Center,
                        modifier = Modifier.fillMaxWidth()
                    ) {
                        Icon(Icons.Default.CheckCircle, contentDescription = null, tint = Color(0xFF00E676))
                        Spacer(modifier = Modifier.width(8.dp))
                        Text(
                            text = state.message,
                            color = Color(0xFF00E676),
                            fontSize = 14.sp,
                            fontWeight = FontWeight.Bold
                        )
                    }
                }
                else -> {}
            }

            Spacer(modifier = Modifier.height(28.dp))
        }
    }
}

ج) کد اصلاح‌شده برای دریافت آهنگ‌ها از کلودفلر و نمایش در جستجو (OnlineMusicRepository در OnlineMusicScreen.kt و SearchScreen.kt)
علت اینکه در جستجو فقط آهنگ‌های خودِ گوشی نمایش داده می‌شوند و آهنگ‌های کلودفلر نمی‌آیند دو چیز است:
 * متد جستجوی کلودفلر در SearchScreen.kt صدا زده نمی‌شد یا وقتی سرور کلودفلر جواب را داخل آبجکت {"results": [...]} یا {"songs": [...]} برمی‌گرداند، پارسر JSON خطا می‌داد و لیست خالی برمی‌گرداند.
 * کد زیر یک کلاینت ضدباگ برای کلودفلر می‌سازد که هم در OnlineMusicScreen.kt و هم در SearchScreen.kt آهنگ‌های کلودفلر را واکشی و فیلتر می‌کند:
package com.example

import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import org.json.JSONArray
import org.json.JSONObject
import java.net.HttpURLConnection
import java.net.URLEncoder
import java.net.URL

data class CloudflareTrack(
    val id: String,
    val title: String,
    val artist: String,
    val streamUrl: String,
    val coverUrl: String? = null,
    val durationMs: Long = 0L,
    val genre: String? = null
)

object CloudflareMusicApi {
    // مهم: آدرس دقیق Worker خودتان در کلودفلر را اینجا قرار دهید
    var workerBaseUrl: String = "https://your-cloudflare-worker.workers.dev"

    suspend fun searchOrFetchTracks(query: String = ""): Result<List<CloudflareTrack>> = withContext(Dispatchers.IO) {
        try {
            val base = workerBaseUrl.trimEnd('/')
            val encodedQuery = URLEncoder.encode(query.trim(), "UTF-8")

            // تلاش اول با مسیر استاندارد جستجو/لیست کلودفلر
            val candidateUrls = if (query.isBlank()) {
                listOf("$base/api/songs", "$base/songs", base)
            } else {
                listOf(
                    "$base/api/search?q=$encodedQuery",
                    "$base/api/songs?q=$encodedQuery",
                    "$base/search?q=$encodedQuery",
                    "$base/api/songs",
                    base
                )
            }

            var lastError: Exception? = null

            for (endpoint in candidateUrls) {
                try {
                    val connection = (URL(endpoint).openConnection() as HttpURLConnection).apply {
                        requestMethod = "GET"
                        connectTimeout = 8000
                        readTimeout = 8000
                        setRequestProperty("Accept", "application/json")
                    }

                    if (connection.responseCode in 200..299) {
                        val responseText = connection.inputStream.bufferedReader().use { it.readText() }
                        val parsedTracks = parseCloudflareJson(responseText, base)
                        
                        // اگر کوئری داشتیم و سرور کل لیست را برگردانده بود، سمت کلاینت هم فیلتر دقیق انجام بده
                        val finalTracks = if (query.isBlank()) {
                            parsedTracks
                        } else {
                            parsedTracks.filter {
                                it.title.contains(query, ignoreCase = true) ||
                                        it.artist.contains(query, ignoreCase = true)
                            }.ifEmpty { parsedTracks }
                        }
                        return@withContext Result.success(finalTracks)
                    }
                } catch (e: Exception) {
                    lastError = e
                }
            }

            Result.failure(lastError ?: Exception("عدم ارتباط با سرور کلودفلر"))
        } catch (e: Exception) {
            Result.failure(e)
        }
    }

    /**
     * پارس هوشمند JSON کلودفلر (سازگار با هم KV و هم دیتابیس D1)
     */
    private fun parseCloudflareJson(jsonString: String, baseUrl: String): List<CloudflareTrack> {
        val trimmed = jsonString.trim()
        val jsonArray: JSONArray = when {
            trimmed.startsWith("[") -> JSONArray(trimmed)
            trimmed.startsWith("{") -> {
                val obj = JSONObject(trimmed)
                obj.optJSONArray("results") // ساختار پیش‌فرض Cloudflare D1
                    ?: obj.optJSONArray("songs")
                    ?: obj.optJSONArray("tracks")
                    ?: obj.optJSONArray("data")
                    ?: obj.optJSONArray("items")
                    ?: JSONArray()
            }
            else -> JSONArray()
        }

        val list = mutableListOf<CloudflareTrack>()
        for (i in 0 until jsonArray.length()) {
            val item = jsonArray.optJSONObject(i) ?: continue
            val id = item.optString("id").ifBlank {
                item.optString("file_id").ifBlank { i.toString() }
            }
            val title = item.optString("title")
                .ifBlank { item.optString("name") }
                .ifBlank { "آهنگ بدون نام" }
            val artist = item.optString("artist")
                .ifBlank { item.optString("performer") }
                .ifBlank { "ناشناس" }

            // ساخت لینک پخش مستقیم در صورتی که فقط file_id یا مسیر نسبی برگشته باشد
            val rawStream = item.optString("streamUrl")
                .ifBlank { item.optString("url") }
                .ifBlank { item.optString("audio_url") }
                .ifBlank { item.optString("stream_url") }

            val streamUrl = when {
                rawStream.startsWith("http") -> rawStream
                rawStream.startsWith("/") -> "$baseUrl$rawStream"
                item.has("file_id") -> "$baseUrl/stream/${item.optString("file_id")}"
                else -> "$baseUrl/stream/$id"
            }

            val coverUrl = item.optString("coverUrl")
                .ifBlank { item.optString("cover") }
                .ifBlank { item.optString("artwork") }
                .takeIf { it.isNotBlank() }

            list.add(
                CloudflareTrack(
                    id = id,
                    title = title,
                    artist = artist,
                    streamUrl = streamUrl,
                    coverUrl = coverUrl,
                    durationMs = item.optLong("duration", 0L) * 1000L,
                    genre = item.optString("genre").takeIf { it.isNotBlank() }
                )
            )
        }
        return list
    }
}

نکته مهم برای آدرس Cloudflare Worker:
در فایل OnlineMusicScreen.kt (یا در متغیر workerBaseUrl بالا)، حتماً مطمئن شو که به جای آدرس پیش‌فرض ([https://your-cloudflare-worker.workers.dev](https://your-cloudflare-worker.workers.dev))، آدرس واقعی ورکر کلودفلر خودت را قرار دهی تا بلافاصله بعد از زدن کد 57589188، آهنگ‌های کانال تلگرام/کلودفلر در بخش سرچ بارگذاری شوند.
