            }

            // نمایش پیام خطا یا تایید
            when (val st = purchaseState) {
                is VipPurchaseState.Error -> {
                    Spacer(modifier = Modifier.height(12.dp))
                    Text(
                        text = st.message,
                        color = Color(0xFFFF5252),
                        fontSize = 13.sp,
                        textAlign = TextAlign.Center
                    )
                }
                is VipPurchaseState.Success -> {
                    Spacer(modifier = Modifier.height(12.dp))
                    Row(verticalAlignment = Alignment.CenterVertically) {
                        Icon(Icons.Default.CheckCircle, contentDescription = null, tint = Color(0xFF00E676))
                        Spacer(modifier = Modifier.width(6.dp))
                        Text(
                            text = st.message,
                            color = Color(0xFF00E676),
                            fontSize = 13.sp,
                            fontWeight = FontWeight.Bold
                        )
                    }
                }
                else -> {}
            }
        }
    }
}

تغییر سوم: اتصال مستقیم SearchScreen.kt و OnlineMusicScreen.kt به کلودفلر پس از باز شدن قفل
در فایل‌های app/src/main/java/com/example/ui/screens/SearchScreen.kt و app/src/main/java/com/example/OnlineMusicScreen.kt:
 * وضعیت val isVip by entitlementManager.isVip.collectAsState() را رصد کن.
 * اگر isVip == false بود، همان کامپوننت VipLockGateCard بالا (که شامل قیمت ۷۵,۰۰۰ تومان، دکمه خرید مایکت بدون باگ و فیلد کد تخفیف 57589188 است) را نمایش بده.
 * به محض اینکه isVip == true شد (یعنی کاربر کد 57589188 را زد)، کارت قفل را مخفی کن و بلافاصله درخواست GET ${workerUrl}/tracks?q=${encodedQuery}&deviceId=${deviceId} را به کلودفلر بفرست و لیست آهنگ‌های برگشتی از کلید tracks در JSON کلودفلر را در صفحه سرچ نمایش بده و با کلیک روی هر آهنگ، فیلد stream_url آن را پخش کن.

