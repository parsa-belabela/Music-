                if (audioSessionId > 0 && it.currentSessionId != audioSessionId) {
                    it.attachToSession(audioSessionId)
                }
            } ?: synchronized(this) {
                INSTANCE ?: AuraDspController(audioSessionId).also { INSTANCE = it }
            }
        }

