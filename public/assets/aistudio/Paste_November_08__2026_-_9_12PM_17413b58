                            onVirtualizerChanged?.invoke(0f)
                        }
                    ) {
                        Icon(
                            imageVector = Icons.Default.Refresh,
                            contentDescription = "Reset",
                            tint = Color.White.copy(alpha = 0.75f)
                        )
                    }

                    Switch(
                        checked = dspState.isEnabled,
                        onCheckedChange = { dspController.setEnabled(it) },
