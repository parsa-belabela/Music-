@Composable
private fun RemoteCoverImage(url: String, modifier: Modifier = Modifier) {
    var bitmap by remember(url) { mutableStateOf(BITMAP_MEM_CACHE[url]) }

    LaunchedEffect(url) {
        if (bitmap == null && url.startsWith("http")) {
            withContext(Dispatchers.IO) {
                try {
                    val conn = (URL(url).openConnection() as HttpURLConnection).apply {
                        instanceFollowRedirects = true
                        connectTimeout = 7000
                        readTimeout = 7000
                        setRequestProperty("User-Agent", "Mozilla/5.0")
                    }
                    if (conn.responseCode == 200) {
                        val bytes = conn.inputStream.readBytes()
                        val bmp = BitmapFactory.decodeByteArray(bytes, 0, bytes.size)
                        if (bmp != null) {
                            BITMAP_MEM_CACHE[url] = bmp
                            bitmap = bmp
                        }
                    }
                } catch (_: Exception) {}
            }
        }
    }

    if (bitmap != null) {
        Image(
            bitmap = bitmap!!.asImageBitmap(),
            contentDescription = null,
            contentScale = ContentScale.Crop,
            modifier = modifier
        )
    } else {
        Box(
            modifier = modifier.background(
                Brush.linearGradient(
                    colors = listOf(Color(0xFF1E293B), Color(0xFF311042))
                )
            ),
            contentAlignment = Alignment.Center
        ) {
            Icon(
                imageVector = Icons.Rounded.MusicNote,
                contentDescription = null,
                tint = Color.White.copy(alpha = 0.4f)
            )
        }
    }
}

private data class CatalogResponse(
    val tracks: List<ArchiveTrack>,
    val allArtists: List<ArchiveArtist>,
    val matchedArtists: List<ArchiveArtist>
)

private suspend fun fetchArchiveCatalog(query: String, artist: String): CatalogResponse = withContext(Dispatchers.IO) {
    try {
        val base = EntitlementManager.WORKER_BASE_URL
        val qEnc = URLEncoder.encode(query, "UTF-8")
        val aEnc = URLEncoder.encode(artist, "UTF-8")
        val url = URL("$base/tracks?q=$qEnc&artist=$aEnc")
        val conn = (url.openConnection() as HttpURLConnection).apply {
            requestMethod = "GET"
            connectTimeout = 9000
            readTimeout = 9000
            setRequestProperty("User-Agent", "Mozilla/5.0")
        }
        if (conn.responseCode != 200) return@withContext CatalogResponse(emptyList(), emptyList(), emptyList())
        val text = conn.inputStream.bufferedReader().use { it.readText() }
        val json = JSONObject(text)

        val tracksArr = json.optJSONArray("data")
        val parsedTracks = mutableListOf<ArchiveTrack>()
        if (tracksArr != null) {
            for (i in 0 until tracksArr.length()) {
                val item = tracksArr.getJSONObject(i)
                parsedTracks.add(
                    ArchiveTrack(
                        id = item.optString("id"),
                        title = item.optString("title", "Unknown"),
                        artist = item.optString("artist_name", "Unknown Artist"),
                        durationSec = item.optInt("duration", 200),
                        streamUrl = item.optString("stream_url"),
                        downloadUrl = item.optString("download_url"),
                        coverUrl = item.optString("cover_url")
                    )
                )
            }
        }

        fun parseArtists(key: String): List<ArchiveArtist> {
            val arr = json.optJSONArray(key) ?: return emptyList()
            val list = mutableListOf<ArchiveArtist>()
            for (i in 0 until arr.length()) {
                val o = arr.getJSONObject(i)
                list.add(
                    ArchiveArtist(
                        name = o.optString("name"),
                        trackCount = o.optInt("trackCount", 1),
                        coverUrl = o.optString("cover")
                    )
                )
            }
            return list
        }

        CatalogResponse(
            tracks = parsedTracks,
            allArtists = parseArtists("artists"),
            matchedArtists = parseArtists("matchedArtists")
        )
    } catch (_: Exception) {
        CatalogResponse(emptyList(), emptyList(), emptyList())
    }
}

private suspend fun downloadArchiveTrackToMusicFolder(context: Context, track: ArchiveTrack): Boolean = withContext(Dispatchers.IO) {
    try {
        val conn = (URL(track.downloadUrl).openConnection() as HttpURLConnection).apply {
            instanceFollowRedirects = true
            connectTimeout = 20000
            readTimeout = 20000
            setRequestProperty("User-Agent", "Mozilla/5.0")
        }
        if (conn.responseCode !in 200..299) return@withContext false
        val safeFileName = "${track.artist} - ${track.title}".replace(Regex("[\\\\/:*?\"<>|]"), "_") + ".mp3"

        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
            val values = ContentValues().apply {
                put(MediaStore.Audio.Media.DISPLAY_NAME, safeFileName)
                put(MediaStore.Audio.Media.TITLE, track.title)
                put(MediaStore.Audio.Media.ARTIST, track.artist)
                put(MediaStore.Audio.Media.MIME_TYPE, "audio/mpeg")
                put(MediaStore.Audio.Media.RELATIVE_PATH, Environment.DIRECTORY_MUSIC + "/AuraMusic")
                put(MediaStore.Audio.Media.IS_PENDING, 1)
            }
            val resolver = context.contentResolver
            val uri = resolver.insert(MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, values) ?: return@withContext false
            resolver.openOutputStream(uri)?.use { out ->
                conn.inputStream.use { input -> input.copyTo(out) }
            }
            values.clear()
            values.put(MediaStore.Audio.Media.IS_PENDING, 0)
            resolver.update(uri, values, null, null)
            true
        } else {
            val dir = File(Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_MUSIC), "AuraMusic")
            if (!dir.exists()) dir.mkdirs()
            val outFile = File(dir, safeFileName)
            FileOutputStream(outFile).use { out ->
                conn.inputStream.use { input -> input.copyTo(out) }
            }
            true
        }
    } catch (_: Exception) {
        false
    }
}

۴. پرامپت مجزا برای Google AI Studio (کپی کن و به همراه ۳ کد بالا به AI Studio بده)
متن زیر را کامل کپی کن و داخل Google AI Studio بفرست تا هم فایل‌ها را در جای دقیق خودشان ذخیره کند و هم مجوز مایکت و استایل مدرن منوی برنامه را تنظیم کند:
لطفاً تغییرات زیر را به صورت کامل و بدون هیچ حذفیاتی در پروژه من اعمال کن تا سیستم اشتراک پریمیوم مادام‌العمر مایکت (با شناسه محصول `yu-15` و قیمت ۷۵,۰۰۰ تومان با تخفیف از ۲۷۵,۰۰۰ تومان)، ظرفیت ۵۰ نفره، قفل سخت‌افزاری، ارسال روزانه ۳ درخواست آهنگ به کانال تلگرام و ظاهر مدرن به سبک Spotify/Apple Music پیاده‌سازی شود:

1. در فایل `app/src/main/AndroidManifest.xml`:
- مجوز پرداخت مایکت را بالای `<application>` اضافه کن:
  `<uses-permission android:name="ir.mservices.market.BILLING" />`
- داخل تگ `<queries>` (یا اگر نیست بالای `<application>` بساز)، پکیج و اینتنت سرویس مایکت را اضافه کن تا در اندروید ۱۱ به بالا به درگاه مایکت وصل شود:
  ```xml
  <queries>
      <package android:name="ir.mservices.market" />
      <intent>
          <action android:name="ir.mservices.market.InAppBillingService.BIND" />
      </intent>
  </queries>

 * جایگزینی ۳ فایل اصلی:
 * کد کامل EntitlementManager.kt را در مسیر app/src/main/java/com/example/monetization/EntitlementManager.kt قرار بده (و اگر در فایل‌های دیگر پروژه مثل MainScreen.kt یا HomeScreen.kt به متدهای قبلی EntitlementManager ارجاع داده شده، آن‌ها را با EntitlementManager.isPremium هماهنگ کن).
 * کد کامل VipPaywallSheet.kt را در مسیر app/src/main/java/com/example/ui/components/VipPaywallSheet.kt جایگزین کن.
 * کد کامل OnlineMusicScreen.kt را در مسیر app/src/main/java/com/example/OnlineMusicScreen.kt جایگزین کن.
 * مدرن‌سازی ظاهر کلی برنامه (MainScreen.kt و HomeScreen.kt):
 * در نوار پایین برنامه (Bottom Navigation) و هدر صفحه اصلی (HomeScreen.kt)، ظاهر کارت‌ها را به سبک اپلیکیشن‌های مدرن (Spotify / Apple Music) با پس‌زمینه تیره عمیق (#090C15)، حاشیه‌های شیشه‌ای ظریف (Color.White.copy(alpha = 0.08f)) و نشان وضعیت پریمیوم (👑 VIP طلایی در صورت فعال بودن یا دکمه «ارتقا به نسخه پریمیوم بتا با ۷۳٪ تخفیف» در صورت عادی بودن) طراحی کن.
 * وقتی کاربر روی تب «آنلاین / آرشیو ابری» کلیک می‌کند، اگر هنوز اشتراک را نخریده باشد، به صورت خودکار همان صفحه قفل پریمیوم (AuraPremiumPaywallContent) با شمارنده ظرفیت ۵۰ نفره و دکمه خرید مایکت نمایش داده شود و به محض خرید، در همان لحظه بدون نیاز به بستن برنامه، آرشیو ابری و دکمه «درخواست آهنگ (۳/۳)» برایش باز شود.

